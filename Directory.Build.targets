<Project>
  <!--
    Local build support, imported by every project in this repository, classic and SDK-style alike, after the project's
    own properties. The settings that SDK-style projects need before their own properties (output layout, assembly info,
    platform, lock files, binding redirects) are in Directory.Build.props, for SDK-style projects only.

    Every project the solution builds now exists in this repository, so nothing is
    swapped for a prebuilt DLL any more. The target that replaced a missing
    ProjectReference with the matching DLL in "Required dlls" was removed once
    ImagingDeviceManager, the last such project, came into the repository: a missing
    project now fails the build instead of quietly using an old binary.
  -->

  <!--
    UnitTests, UnitTestsCore and the test projects reference MSTest v1
    (Microsoft.VisualStudio.QualityTools.UnitTestFramework) by name only. Visual Studio
    and Build Tools install it under Common7\IDE, which MSBuild does not search by default.
    VsInstallRoot is the instance whose MSBuild builds: Build Tools 2026 keep the file under
    Common7\IDE\Extensions\TestPlatform, as Build Tools 2022 do. An SDK-style net48 project resolves
    it the same way (the S1-0 offline check of docs/specs/net10-plan.md).
  -->
  <Target Name="ODAddMSTestV1SearchPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(VsInstallRoot)' != ''">
    <PropertyGroup>
      <AssemblySearchPaths Condition="Exists('$(VsInstallRoot)\Common7\IDE\PublicAssemblies')">$(AssemblySearchPaths);$(VsInstallRoot)\Common7\IDE\PublicAssemblies</AssemblySearchPaths>
      <AssemblySearchPaths Condition="Exists('$(VsInstallRoot)\Common7\IDE\Extensions\TestPlatform')">$(AssemblySearchPaths);$(VsInstallRoot)\Common7\IDE\Extensions\TestPlatform</AssemblySearchPaths>
    </PropertyGroup>
  </Target>

  <!--
    A test project with no app.config of its own builds with tests\BindingRedirects.config, the programs'
    binding redirects. Reference resolution follows them: without them it looks for the exact older version
    a library was built against (System.Memory 4.0.1.2 for MySqlConnector, say), skips the newer copy in
    "Required dlls" and takes the old one in the test platform folder above. With them the test's output
    gets the files of "Required dlls", and its generated .dll.config redirects to them
    (tests\LibraryBindingTests).
  -->
  <PropertyGroup Condition="'$(AppConfig)' == '' and $(MSBuildProjectName.EndsWith('Tests')) and !Exists('$(MSBuildProjectDirectory)\app.config')">
    <AppConfig>$(MSBuildThisFileDirectory)tests\BindingRedirects.config</AppConfig>
  </PropertyGroup>

  <!--
    System.ValueTuple comes from the .NET Framework: 4.7 and later bind every 4.0.x reference to the copy in the
    global assembly cache (4.0.0.0), and "Required dlls" has none (tests\LibraryBindingTests). The libraries
    reference different 4.0.x versions (PDFsharp and MigraDoc 6.5: 4.0.2.0; SSH.NET, System.Text.Json,
    System.Formats.Asn1 and Microsoft.Bcl.Cryptography: 4.0.5.0), so reference resolution suggests a redirect to
    4.0.5.0, a version no computer has; a .config with that redirect makes every load of System.ValueTuple
    fail. The suggestion is dropped, so the framework's own binding stays in charge.
  -->
  <Target Name="ODDropValueTupleRedirect" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GenerateBindingRedirects">
    <ItemGroup>
      <_ODValueTupleRedirect Include="@(SuggestedBindingRedirects)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('System.ValueTuple,'))" />
      <SuggestedBindingRedirects Remove="@(_ODValueTupleRedirect)" />
    </ItemGroup>
  </Target>
</Project>
