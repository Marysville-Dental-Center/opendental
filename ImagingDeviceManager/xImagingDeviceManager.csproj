<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!--
    Open source TWAIN scanning library. Replaces the proprietary ImagingDeviceManager.dll,
    which wrapped the commercial EZTwain library (Eztwain4.dll). Talks directly to the standard
    TWAIN Data Source Manager (TWAINDSM.dll, or the legacy twain_32.dll) through P/Invoke.
    TWAIN on Windows is 32-bit here, so the assembly is always built for x86.
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{783079E6-A13F-4F43-A28D-9D7731F945D1}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ImagingDeviceManager</RootNamespace>
    <AssemblyName>ImagingDeviceManager</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <TargetFrameworkProfile />
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PdfSharp, Version=1.2.1269.0, Culture=neutral, PublicKeyToken=f94615aa0424f9eb, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Required dlls\PdfSharp.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="EZTwain.cs" />
    <Compile Include="EZTwainErrorCode.cs" />
    <Compile Include="Enums.cs" />
    <Compile Include="ImagingDeviceException.cs" />
    <Compile Include="Twain.cs" />
    <Compile Include="Imaging\DibImage.cs" />
    <Compile Include="Imaging\DibBuilder.cs" />
    <Compile Include="Imaging\DibHandleTable.cs" />
    <Compile Include="Imaging\PdfPageWriter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TwainProtocol\ITwainDsm.cs" />
    <Compile Include="TwainProtocol\NativeMethods.cs" />
    <Compile Include="TwainProtocol\NativeTwainDsm.cs" />
    <Compile Include="TwainProtocol\ProxyWindow.cs" />
    <Compile Include="TwainProtocol\TwainConstants.cs" />
    <Compile Include="TwainProtocol\TwainSession.cs" />
    <Compile Include="TwainProtocol\TwainStructs.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
