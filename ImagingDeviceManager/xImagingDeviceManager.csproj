<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Open source TWAIN scanning library. Replaces the proprietary ImagingDeviceManager.dll,
    which wrapped the commercial EZTwain library (Eztwain4.dll). Talks directly to the standard
    TWAIN Data Source Manager (TWAINDSM.dll, or the legacy twain_32.dll) through P/Invoke.
    TWAIN on Windows is 32-bit here, so the assembly is always built for x86 (Directory.Build.props).
    Every .cs file under this folder is compiled, so packages that add files never conflict over this project file.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ImagingDeviceManager</RootNamespace>
    <AssemblyName>ImagingDeviceManager</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <!-- The status and Cancel window and the notices of device acquisitions (UI folder). -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
  </ItemGroup>
</Project>
