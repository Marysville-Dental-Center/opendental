  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Build time of OpenPmsDental.exe, for the release channel: [assembly: AssemblyMetadata("ForkBuildUtc", "yyyy-MM-ddTHH:mm:ssZ")]
       (ForkReleases.GetBuildUtc). The release version stays "0.0" across builds, so the build time orders two builds of one release and a workstation
       never publishes an older build over a newer one (docs/release-process.md). The stamp is rewritten only when something that is compiled into
       OpenPmsDental.exe changed, so an unchanged rebuild keeps its build id. It comes after the Sdk.targets import, where $(IntermediateOutputPath)
       is known. -->
  <PropertyGroup>
    <ForkBuildStampFile>$(IntermediateOutputPath)ForkBuildStamp.cs</ForkBuildStampFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- UpdateFileCopier.exe is part of the build id, so a change to it counts as a new build too. Missing inputs would force a new stamp at every build. -->
    <ForkBuildStampInput Include="..\UpdateFileCopier\bin\$(Configuration)\UpdateFileCopier.exe" Condition="Exists('..\UpdateFileCopier\bin\$(Configuration)\UpdateFileCopier.exe')" />
  </ItemGroup>
  <Target Name="ForkWriteBuildStamp" BeforeTargets="CoreCompile" Inputs="@(Compile);@(ReferencePath);@(EmbeddedResource);$(MSBuildProjectFullPath);@(ForkBuildStampInput)" Outputs="$(ForkBuildStampFile)">
    <PropertyGroup>
      <ForkBuildUtc>$([System.DateTime]::UtcNow.ToString(`yyyy-MM-dd'T'HH:mm:ss'Z'`))</ForkBuildUtc>
    </PropertyGroup>
    <WriteLinesToFile File="$(ForkBuildStampFile)" Lines="// Generated by OpenPmsDental.csproj (ForkWriteBuildStamp). Do not edit.;[assembly: System.Reflection.AssemblyMetadata(&quot;ForkBuildUtc&quot;,&quot;$(ForkBuildUtc)&quot;)]" Overwrite="true" />
  </Target>
  <Target Name="ForkIncludeBuildStamp" BeforeTargets="CoreCompile" AfterTargets="ForkWriteBuildStamp">
    <ItemGroup>
      <Compile Include="$(ForkBuildStampFile)" />
      <FileWrites Include="$(ForkBuildStampFile)" />
    </ItemGroup>
  </Target>
  <Target Name="CopyUpdateFileCopier" AfterTargets="Build" Condition="Exists('..\UpdateFileCopier\bin\$(Configuration)\UpdateFileCopier.exe')">
    <Copy SourceFiles="..\UpdateFileCopier\bin\$(Configuration)\UpdateFileCopier.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
