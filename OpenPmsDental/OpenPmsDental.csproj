<Project>
  <!--
    OpenPmsDental.exe, the program. The SDK's default globs compile every .cs file and embed every .resx file under this folder (bin\ and
    obj\ excepted), so a new form, a new partial file or a new .resx needs no edit here; every other file under the folder is a None item
    unless an item below makes it something else. Only items with their own metadata are listed: the linked SharedAssemblyInfo.cs, the
    designer and partial files (DependentUpon), the .resx files whose resource names come from their form's class (DependentUpon), the
    generated files, the embedded cursors and branding, the WPF resources, the Content items, the web reference and the native file copied
    to the output.

    Sdk.props and Sdk.targets are imported explicitly, not through the Sdk attribute, so that the build stamp block at the end comes after
    Sdk.targets: its file is $(IntermediateOutputPath)ForkBuildStamp.cs, and the SDK computes $(IntermediateOutputPath) in Sdk.targets.
    Every item stays before the Sdk.targets import, where the SDK gives an item outside the folder its Link (WebView2Loader.dll).

    AutoGenerateBindingRedirects is left to its default, on for an exe, as for the classic project: OpenPmsDental.exe.config is app.config
    with the redirects it holds (tests\LibraryBindingTests checks them).
  -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenPmsDental</RootNamespace>
    <AssemblyName>OpenPmsDental</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <CodeAnalysisRuleSet>OpenPmsDental.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <WarningLevel>3</WarningLevel>
    <DocumentationFile>bin\Release\OpenPmsDental.xml</DocumentationFile>
    <!-- The classic Release|x86 configuration defined no symbols: no TRACE, which the SDK would otherwise add (only its implicit RELEASE
         and framework symbols remain). -->
    <DefineConstants></DefineConstants>
    <!--
      GenerateSerializationAssemblies stays at its default, Auto: a Release build runs SGen because the project has a WebReferenceUrl item
      (below), and OpenPmsDental.XmlSerializers.dll ships (tools/Build-Release.ps1). MSBuild turns SGen off for Debug builds.
    -->
  </PropertyGroup>
