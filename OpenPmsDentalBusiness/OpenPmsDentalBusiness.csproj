<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The business layer. The SDK's default globs compile every .cs file and embed every .resx file under this folder (bin\ and obj\ excepted),
    so a new file, a new Crud or Data Interface file from xCrudGenerator, a fork migration step or a vendor-direct file included, needs no edit
    here. Every other file under the folder is a None item unless an item below makes it something else. Only items with their own metadata
    are listed: the linked SharedAssemblyInfo.cs, the designer and generated files, the class-based resource names, the schema references with
    their LogicalName, the WPF resources, the Content items and the web references.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenPmsDentalBusiness</RootNamespace>
    <AssemblyName>OpenPmsDentalBusiness</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>3</WarningLevel>
    <DocumentationFile>bin\Release\OpenPmsDentalBusiness.xml</DocumentationFile>
    <!--
      GenerateSerializationAssemblies stays at its default, Auto: a Release build runs SGen because the project has WebReferenceUrl items
      (below), and OpenPmsDentalBusiness.XmlSerializers.dll ships (tools/Build-Release.ps1). MSBuild turns SGen off for Debug builds.
    -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Google APIs Client Library for .NET 1.78 (lib\net462) and the Gmail API 1.77.0.4295, for Gmail send and download (GoogleApiConnector).
         Since 1.50 the library has no PlatformServices assemblies. Only this project compiles against them (PrivateAssets compile): their
         root namespace Google would hide this project's Google class from every project that uses it (Google.AuthorizationRequest,
         Google.SignOutAsync), as the projects that reference this one never compiled against them. They still get the files. -->
    <PackageReference Include="Google.Apis" PrivateAssets="compile" />
    <PackageReference Include="Google.Apis.Auth" PrivateAssets="compile" />
    <PackageReference Include="Google.Apis.Core" PrivateAssets="compile" />
    <PackageReference Include="Google.Apis.Gmail.v1" PrivateAssets="compile" />
    <!-- MailKit and MimeKit 4.18.2 (lib\net48): POP3 receive (EmailMessages.ReceiveFromInbox) and the MIME messages of Gmail and Microsoft 365.
         Both use BouncyCastle.Cryptography 2.7, which comes with MimeKit's package. -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />
    <!-- MSAL 4.92.0 (lib\net472) for the vendor-direct Microsoft 365 sign-in (M365-LIB); see docs/specs/vendor-direct/microsoft-365.md. It uses
         System.Text.Json and System.Text.Encodings.Web 10.0.14, which come with its package at the versions of Directory.Packages.props
         (MSAL asks for 6.0, the redirects send it to them). -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <!-- MSAL's own dependency (its IIdentityLogger), 8.14.0. Used by Microsoft365Session, so every program hosting the sign-in copies it and
         gets the binding redirect to it. The Graph SDK's dependencies brought it in until the prebuilt Bridges assembly and the Graph SDK were
         deleted. -->
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Health.Direct.Agent">
      <HintPath>..\Required dlls\Health.Direct.Agent.dll</HintPath>
    </Reference>
    <Reference Include="Health.Direct.Common">
      <HintPath>..\Required dlls\Health.Direct.Common.dll</HintPath>
    </Reference>
    <Reference Include="Health.Direct.ResolverPlugins">
      <HintPath>..\Required dlls\Health.Direct.ResolverPlugins.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="MySqlConnector" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Windows" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- PDFsharp 6.5 (GDI+ build) and the two assemblies it loads at run time, built from empira's source (third-party\build), so every
         program that uses this library copies them. PdfSharp-gdi holds the AGPL licence check that PdfSharpSetup.Init satisfies. -->
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\third-party\build\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\third-party\build\PdfSharp.System\PdfSharp.System.csproj" />
    <ProjectReference Include="..\ODCrypt\xODCrypt.csproj" />
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalStorage\OpenPmsDentalStorage.csproj" />
    <ProjectReference Include="..\PasswordVaultWrapper\PasswordVaultWrapper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="UI\SignatureBox.Designer.cs">
      <DependentUpon>SignatureBox.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\SignatureBoxWrapper.Designer.cs">
      <DependentUpon>SignatureBoxWrapper.cs</DependentUpon>
    </Compile>
    <!-- The proxy classes of the six web references, generated from their Reference.map. -->
    <Compile Update="Web References\*\Reference.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Reference.map</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- The class-based resource names (OpenPmsDental.UI.GridCell.resources, ...) come from DependentUpon: the classes are in namespace
         OpenPmsDental.UI, not in the root namespace. -->
    <EmbeddedResource Update="UI\GridCell.resx">
      <DependentUpon>GridCell.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\GridColumn.resx">
      <DependentUpon>GridColumn.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\GridOld.resx">
      <DependentUpon>GridOld.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\GridOD.resx">
      <DependentUpon>GridOD.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\GridRow.resx">
      <DependentUpon>GridRow.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\ODGridPageNav.resx">
      <DependentUpon>ODGridPageNav.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\SignatureBoxWrapper.resx">
      <DependentUpon>SignatureBoxWrapper.cs</DependentUpon>
    </EmbeddedResource>
    <!-- The Open Dental schema references of the fork migrations, by file name (SchemaVerifier reads them as OdSchema-<version>.sql). -->
    <EmbeddedResource Include="Misc\ForkMigrations\Reference\OdSchema-25.3.48.sql">
      <LogicalName>OdSchema-25.3.48.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Misc\ForkMigrations\Reference\OdSchema-26.1.70.sql">
      <LogicalName>OdSchema-26.1.70.sql</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Misc\ForkMigrations\Reference\OdSchema-26.2.0.sql">
      <LogicalName>OdSchema-26.2.0.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- WPF resources in OpenPmsDentalBusiness.g.resources (resources/deletex10.gif, ...). The .NET Framework WinFX targets build them, as for
         the classic project: the SDK imports those targets for a .NETFramework project without UseWPF. -->
    <Resource Include="Resources\deleteX10.gif" />
    <Resource Include="Resources\eSig.gif" />
    <Resource Include="Resources\topazPen10.gif" />
    <!-- Content items, as in the classic project file, not copied to the output folder: Properties\Resources.resx embeds the claim forms, the
         eForms and the payment plan sheet by their paths, and Shared\README.txt says what the Shared folder is for. -->
    <Content Include="Resources\ClaimForms\ClaimForm1500.xml" />
    <Content Include="Resources\ClaimForms\ClaimForm1500_02_12.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2000.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2002.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2006.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2012.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2012_J430D.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormADA 2019.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormDenti-Cal.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormHCFA-1500 preprinted.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormHCFA-1500.xml" />
    <Content Include="Resources\ClaimForms\ClaimFormUB04.xml" />
    <Content Include="Resources\EForms\EFormMedicalHistory.xml" />
    <Content Include="Resources\EForms\EFormPatientRegistration.xml" />
    <Content Include="Resources\PaymentPlan.xml" />
    <Content Include="Shared\README.txt" />
    <!-- The files above are Resource, Content or EmbeddedResource items only, not None items of the default glob as well. -->
    <None Remove="@(Resource);@(Content);@(EmbeddedResource)" />
    <!--
      Three files on disk that the classic project file did not list stay out of the items, so the project has the items it had: the
      Mono-era change log of the data connection (2007), the fork migrations' README and the Denti-Cal DC217 claim form, which
      Properties\Resources.resx embeds by its path (ClaimFormDenti_Cal_DC217_2019), as it does the other claim forms.
    -->
    <None Remove="ChangeLog" />
    <None Remove="Misc\ForkMigrations\README.md" />
    <None Remove="Resources\ClaimForms\ClaimFormDenti-Cal DC217_2019.xml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Web References\*\Reference.map">
      <Generator>MSDiscoCodeGenerator</Generator>
      <LastGenOutput>Reference.cs</LastGenOutput>
    </None>
    <None Update="Web References\*\*.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--
      The web references. With them, a Release build runs SGen (GenerateSerializationAssemblies Auto) and writes
      OpenPmsDentalBusiness.XmlSerializers.dll. WebReferences and WCFMetadata are the folders Visual Studio keeps them in.
    -->
    <WebReferences Include="Web References\" />
    <WCFMetadata Include="Service References\" />
    <WebReferenceUrl Include="http://localhost/OpenDentalServer/ServiceMain.asmx">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\OpenDentalServer\</RelPath>
      <UpdateFromURL>http://localhost/OpenDentalServer/ServiceMain.asmx</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_OpenDentalServer_ServiceMain</CachedSettingsPropName>
    </WebReferenceUrl>
    <WebReferenceUrl Include="https://its.changehealthcare.com/ITS/ITSWS.asmx%3fwsdl">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\EmdeonITS\</RelPath>
      <UpdateFromURL>https://its.changehealthcare.com/ITS/ITSWS.asmx%3fwsdl</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_EmdeonITS_ITSWS</CachedSettingsPropName>
    </WebReferenceUrl>
    <WebReferenceUrl Include="https://prelive2.dentalxchange.com/dea/DeaPartnerService%3fwsdl">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\DentalxchangePartnerService\</RelPath>
      <UpdateFromURL>https://prelive2.dentalxchange.com/dea/DeaPartnerService%3fwsdl</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_DentalxchangePartnerService_DeaPartnerService</CachedSettingsPropName>
    </WebReferenceUrl>
    <WebReferenceUrl Include="https://secure.newcropaccounts.com/v7/WebServices/Update1.asmx">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\NewCropWebService\</RelPath>
      <UpdateFromURL>https://secure.newcropaccounts.com/v7/WebServices/Update1.asmx</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_NewCrop_Update1</CachedSettingsPropName>
    </WebReferenceUrl>
    <WebReferenceUrl Include="https://webservices.dentalxchange.com/dws/DwsService%3fwsdl">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\Dentalxchange2016\</RelPath>
      <UpdateFromURL>https://webservices.dentalxchange.com/dws/DwsService%3fwsdl</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_Dentalxchange2016_DwsService</CachedSettingsPropName>
    </WebReferenceUrl>
    <WebReferenceUrl Include="https://webservices.dentalxchange.com/dws/webservice/wsdl.jsp">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\com.dentalxchange.webservices\</RelPath>
      <UpdateFromURL>https://webservices.dentalxchange.com/dws/webservice/wsdl.jsp</UpdateFromURL>
      <ServiceLocationURL>
      </ServiceLocationURL>
      <CachedDynamicPropName>
      </CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>OpenDentBusiness_com_dentalxchange_webservices_WebServiceService</CachedSettingsPropName>
    </WebReferenceUrl>
  </ItemGroup>
</Project>
