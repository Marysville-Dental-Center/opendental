<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="OpenPmsDentalBusiness.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <OpenPmsDentalBusiness.Properties.Settings>
            <setting name="OpenDentBusiness_OpenDentalServer_ServiceMain"
                serializeAs="String">
                <value>http://localhost/OpenDentalServer/ServiceMain.asmx</value>
            </setting>
            <setting name="OpenDentBusiness_Dentalxchange2016_DwsService"
                serializeAs="String">
                <value>https://webservices.dentalxchange.com:443/dws/DwsService</value>
            </setting>
            <setting name="OpenDentBusiness_com_dentalxchange_webservices_WebServiceService"
                serializeAs="String">
                <value>https://webservices.dentalxchange.com/dws/services/dciservice.svl</value>
            </setting>
            <setting name="OpenDentBusiness_EmdeonITS_ITSWS" serializeAs="String">
                <value>https://its.changehealthcare.com/ITS/ITSWS.asmx</value>
            </setting>
            <setting name="OpenDentBusiness_DentalxchangePartnerService_DeaPartnerService"
                serializeAs="String">
                <value>https://prelive2.dentalxchange.com:443/dea/DeaPartnerService</value>
            </setting>
            <setting name="OpenDentBusiness_WebServiceMainHq_Mock" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="OpenDentBusiness_NewCrop_Update1" serializeAs="String">
                <value>https://secure.newcropaccounts.com/v7/WebServices/Update1.asmx</value>
            </setting>
        </OpenPmsDentalBusiness.Properties.Settings>
    </applicationSettings>
  <runtime>
    <!-- The support assemblies in "Required dlls" are newer than the versions the libraries were built against: every older version goes to the
         one that ships. tests/LibraryBindingTests checks these redirects against the files there. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
