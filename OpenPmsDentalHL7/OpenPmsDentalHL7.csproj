<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The HL7 Windows service (OpenPmsDentalHL7.exe, ServiceHL7), with its installer and its debug window. The SDK's default globs compile
    every .cs file and embed every .resx file under this folder (bin\ and obj\ excepted); only items with their own metadata are listed.
    AutoGenerateBindingRedirects is left to its default, on for an exe, as for the classic project: no reference conflicts today, so
    OpenPmsDentalHL7.exe.config is app.config as it is.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenPmsDentalHL7</RootNamespace>
    <AssemblyName>OpenPmsDentalHL7</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalStorage\OpenPmsDentalStorage.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="FormDebug.Designer.cs">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </Compile>
    <Compile Update="ServiceHL7.Designer.cs">
      <DependentUpon>ServiceHL7.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="FormDebug.resx">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
