<local:FrmODBase
	x:Class="OpenPmsDental.FrmProcNoteMerge"
	xmlns:local="clr-namespace:OpenPmsDental"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:UI="clr-namespace:WpfControls.UI"
	mc:Ignorable="d"
	Text="Procedure Note Merge"
	Height="660" Width="900">
	<Grid Background="White">
		<Grid Margin="12,8,12,8">
			<Grid.RowDefinitions>
				<RowDefinition Height="40"/>
				<RowDefinition Height="22"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="22"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="36"/>
				<RowDefinition Height="36"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<UI:Label x:Name="labelIntro" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsWrap="True"
				Text="Another user saved a newer note on this procedure while you were editing it. Choose which note to save, or edit the merged note."/>
			<UI:Label x:Name="labelTheirs" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Their note"/>
			<UI:Label x:Name="labelMine" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Your note"/>
			<UI:TextBox x:Name="textTheirs" Grid.Row="2" Grid.Column="0" Margin="0,0,6,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				IsMultiline="True" ReadOnly="True" TabIndexOD="4"/>
			<UI:TextBox x:Name="textMine" Grid.Row="2" Grid.Column="1" Margin="6,0,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				IsMultiline="True" ReadOnly="True" TabIndexOD="5"/>
			<UI:Label x:Name="labelMerged" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				Text="Merged note (their note, a separator line, then the text you added; you can edit it)"/>
			<UI:TextBox x:Name="textMerged" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				IsMultiline="True" TabIndexOD="1"/>
			<UI:Label x:Name="labelSignatures" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsWrap="True"
				ColorText="#FFB22222" Text="A saved text that differs from the text that was signed clears the signature, and the note must be signed again."/>
			<UI:Button x:Name="butCancel" Grid.Row="6" Grid.Column="0" Width="80" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom"
				Text="Cancel" Click="butCancel_Click"/>
			<StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
				<UI:Button x:Name="butKeepMine" Width="90" Height="24" Margin="0,0,8,0" Text="Keep Mine" Click="butKeepMine_Click"/>
				<UI:Button x:Name="butKeepTheirs" Width="90" Height="24" Margin="0,0,8,0" Text="Keep Theirs" Click="butKeepTheirs_Click"/>
				<UI:Button x:Name="butSaveMerged" Width="96" Height="24" Text="_Save Merged" Click="butSaveMerged_Click"/>
			</StackPanel>
		</Grid>
	</Grid>
</local:FrmODBase>
