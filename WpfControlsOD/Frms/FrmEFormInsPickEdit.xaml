<local:FrmODBase x:Class="OpenDental.FrmEFormInsPickEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="640" Height="560"
             Text="Edit Ins Pick" MinMaxBoxes="False">
	<Grid Background="#FFFCFDFE" >
		<ui:Button x:Name="butDelete" Width="84" VerticalAlignment="Bottom" Height="24" Margin="28,0,0,18" Text="Delete" Icon="DeleteX" Click="butDelete_Click" />
		<ui:Button x:Name="butSave" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,28,18" Text="_Save" Click="butSave_Click" />
		<ui:GroupBox x:Name="groupLanguage" Height="148" Margin="73,10,0,0" Width="470" Text="Language Translation">
			<ui:Label x:Name="labelLanguage" Width="98" Height="18" Margin="15,20,0,0" Text="Language" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textLanguage" Width="163" Height="20" Margin="114,20,0,0" ReadOnly="True" ColorBack="#FFF0F0F0" />
			<ui:Label Width="98" Height="18" Margin="15,45,0,0" Text="Label" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textLabelTranslated" Width="213" Height="20" Margin="114,45,0,0"/>
			<ui:Label Width="98" Height="18" Margin="15,70,0,0" Text="None" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textOptionNoneTranslated" Width="163" Height="20" Margin="114,70,0,0"/>
			<ui:Label Width="98" Height="18" Margin="15,95,0,0" Text="New" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textOptionNewTranslated" Width="163" Height="20" Margin="114,95,0,0"/>
			<ui:Label Width="98" Height="18" Margin="15,120,0,0" Text="Existing" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textOptionExistingTranslated" Width="163" Height="20" Margin="114,120,0,0"/>
		</ui:GroupBox>
		<ui:Label Width="120" Height="18" Margin="64,170,0,0" Text="Insurance slot" HAlign="Right" VAlign="Center" />
		<ui:ComboBox x:Name="comboSlot" Width="213" Height="21" Margin="187,169,0,0" />
		<ui:Label Height="34" Margin="404,168,0,0" Text="Which insurance this asks about. Import makes pending insurance with this ordinal." VAlign="Top" Width="215" />
		<ui:Label Width="98" Height="18" Margin="86,205,0,0" Text="Label" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textLabel" Width="213" Height="20" Margin="187,205,0,0"/>
		<ui:Label Height="18" Margin="404,205,0,0" Text="Shows above the three choices" VAlign="Center" Width="200" />
		<ui:Label Width="120" Height="18" Margin="64,231,0,0" Text="Choice: None" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textOptionNone" Width="163" Height="20" Margin="187,231,0,0"/>
		<ui:Label Width="120" Height="18" Margin="64,256,0,0" Text="Choice: New" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textOptionNew" Width="163" Height="20" Margin="187,256,0,0"/>
		<ui:Label Width="120" Height="18" Margin="64,281,0,0" Text="Choice: Existing" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textOptionExisting" Width="163" Height="20" Margin="187,281,0,0"/>
		<ui:Label Height="48" Margin="354,231,0,0" Text="Child fields with this field as their conditional parent and the value New show when New is picked." VAlign="Top" Width="250" />
		<ui:CheckBox x:Name="checkAutoImport" Height="20" Margin="41,309,0,0" Width="159" Text="Auto Import" CheckAlign="MiddleRight"/>
		<ui:CheckBox x:Name="checkBorder" Height="20" Margin="41,332,0,0" Width="159" Text="Show Border Box" CheckAlign="MiddleRight"/>
		<ui:Label Width="98" Height="18" Margin="88,357,0,0" Text="Font Scale" HAlign="Right" VAlign="Center" />
		<ui:TextVInt x:Name="textVIntFontScale" Width="54" Height="20" Margin="187,357,0,0" MaxVal="300" MinVal="50"/>
		<ui:Label Height="18" Margin="245,357,0,0" Text="default is 100" VAlign="Center" Width="228" />
		<ui:Label Width="98" Height="18" Margin="88,383,0,0" Text="Space Below" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textSpaceBelow" Width="54" Height="20" Margin="187,383,0,0" />
		<ui:Label x:Name="labelSpaceDefault" Height="18" Margin="245,383,0,0" Text="leave blank to use the default value of" VAlign="Center" Width="265" />
		<ui:GroupBox Height="80" Margin="28,414,0,0" Width="470" Text="Conditional Logic. This field will show...">
			<ui:Label Width="128" Height="18" Margin="32,27,0,0" Text="... if the parent field" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textCondParent" Width="213" Height="20" Margin="159,25,0,0"/>
			<ui:Label Width="156" Height="18" Margin="5,51,0,0" Text="... has the following value(s)" HAlign="Right" VAlign="Center" />
			<ui:TextBox x:Name="textCondValue" Width="213" Height="20" Margin="159,50,0,0"/>
			<ui:Button x:Name="butPickParent" Width="66" Height="24" Margin="379,22,0,0" Text="Pick" Click="butPickParent_Click"/>
			<ui:Button x:Name="butPickValue" Width="66" Height="24" Margin="379,48,0,0" Text="Pick" Click="butPickValue_Click" />
		</ui:GroupBox>
	</Grid>
</local:FrmODBase>
