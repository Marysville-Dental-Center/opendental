<local:FrmODBase x:Class="OpenPmsDental.FrmStatementSendSetup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenPmsDental"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="470" Height="320"
             Text="Statement Send Setup" MinMaxBoxes="False">
	<Grid Background="#FFFCFDFE" >
		<ui:Label Width="430" Height="18" Margin="14,14,0,0" Text="When billing creates statements (Billing Options, Create List), send them:" />
		<ui:Label Width="130" Height="18" Margin="14,42,0,0" Text="By e-mail" HAlign="Right" VAlign="Center" />
		<ui:ComboBox x:Name="comboEmail" Width="120" Height="21" Margin="148,41,0,0" />
		<ui:Label Width="300" Height="34" Margin="148,64,0,0" Text="Statements whose mode is E-mail, to the patient's e-mail address, as the Billing List's Send button does." />
		<ui:Label Width="130" Height="18" Margin="14,104,0,0" Text="By text" HAlign="Right" VAlign="Center" />
		<ui:ComboBox x:Name="comboSms" Width="120" Height="21" Margin="148,103,0,0" />
		<ui:Label x:Name="labelTextNeedsProvider" Width="300" Height="34" Margin="148,126,0,0" Text="Texting statements needs a texting provider. None is set up, so no statement is texted." />
		<ui:Label x:Name="labelAlwaysNotSavedHere" Width="434" Height="64" Margin="14,166,0,0" ColorText="#FFB22222" Text="(set on load)" />
		<ui:Button x:Name="butSave" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,12,12" Text="_Save" Click="butSave_Click" />
	</Grid>
</local:FrmODBase>
