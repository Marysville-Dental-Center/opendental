<local:FrmODBase x:Class="OpenDental.FrmEFormPatientAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="360" Height="230"
             Text="Add Family Member" MinMaxBoxes="False" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label Width="100" Height="18" Margin="10,24,0,0" Text="First Name" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textFName" Width="200" Height="20" Margin="113,23,0,0" />
		<ui:Label Width="100" Height="18" Margin="10,51,0,0" Text="Last Name" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textLName" Width="200" Height="20" Margin="113,50,0,0" />
		<ui:Label Width="100" Height="18" Margin="10,78,0,0" Text="Birthdate" HAlign="Right" VAlign="Center" />
		<ui:TextVDate x:Name="textBirthdate" Width="100" Height="20" Margin="113,77,0,0" />
		<ui:Button x:Name="butOK" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,109,20" Text="_OK" Click="butOK_Click" />
		<ui:Button x:Name="butCancel" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,28,20" Text="Cancel" Click="butCancel_Click" />
	</Grid>
</local:FrmODBase>
