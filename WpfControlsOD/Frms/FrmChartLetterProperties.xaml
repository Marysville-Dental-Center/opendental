<local:FrmODBase x:Class="OpenDental.FrmChartLetterProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental"
             xmlns:oduiodb="clr-namespace:OpenDental.UI;assembly=OpenDentBusiness"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="640" Height="500"
             Text="Chart Letter Properties" MinMaxBoxes="False" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelDocNum" Width="125" Height="18" Margin="500,7,0,0" Text="DocNum:" />
		<ui:Label x:Name="labelStatus" Width="120" Height="18" Margin="12,14,0,0" Text="Status" HAlign="Right" />
		<ui:TextBox x:Name="textStatus" Width="160" Height="20" Margin="135,12,0,0" ColorBack="#FFF0F0F0" ReadOnly="True" TabIndexOD="20" />
		<ui:Label x:Name="labelDate" Width="120" Height="18" Margin="12,40,0,0" Text="Date" HAlign="Right" />
		<ui:TextVDate x:Name="textDate" Width="104" Height="20" Margin="135,38,0,0" TabIndexOD="1" />
		<ui:Label x:Name="labelTime" Width="120" Height="18" Margin="12,64,0,0" Text="Time" HAlign="Right" />
		<ui:TextBox x:Name="textTime" Width="104" Height="20" Margin="135,62,0,0" TabIndexOD="2" />
		<ui:Label x:Name="labelDescript" Width="120" Height="18" Margin="12,88,0,0" Text="Description" HAlign="Right" />
		<ui:TextBox x:Name="textDescript" Width="300" Height="20" Margin="135,86,0,0" MaxLength="255" TabIndexOD="0" />
		<ui:Label x:Name="labelProv" Width="120" Height="18" Margin="12,112,0,0" Text="Provider" HAlign="Right" />
		<ui:ComboBox x:Name="comboProv" Width="173" Height="21" Margin="135,110,0,0" />
		<ui:Label x:Name="labelUser" Width="120" Height="18" Margin="12,137,0,0" Text="Content changed by" HAlign="Right" />
		<ui:TextBox x:Name="textUser" Width="173" Height="20" Margin="135,135,0,0" ColorBack="#FFF0F0F0" ReadOnly="True" TabIndexOD="21" />
		<ui:Label x:Name="labelHashFile" Width="120" Height="18" Margin="12,165,0,0" Text="File hash" HAlign="Right" />
		<ui:TextBox x:Name="textHashFile" Width="300" Height="20" Margin="135,163,0,0" ColorBack="#FFF0F0F0" ReadOnly="True" TabIndexOD="22" />
		<ui:Label x:Name="labelHashStored" Width="120" Height="18" Margin="12,189,0,0" Text="Stored hash" HAlign="Right" />
		<ui:TextBox x:Name="textHashStored" Width="300" Height="20" Margin="135,187,0,0" ColorBack="#FFF0F0F0" ReadOnly="True" TabIndexOD="23" />
		<ui:Label x:Name="labelMatch" Width="160" Height="18" Margin="445,177,0,0" Text="Match" VAlign="Center" />
		<ui:Label x:Name="labelSignature" Width="120" Height="18" Margin="12,218,0,0" Text="Signature" HAlign="Right" />
		<WindowsFormsHost Margin="135,216,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="362" Height="79">
			<oduiodb:SignatureBoxWrapper x:Name="signatureBoxWrapper"/>
		</WindowsFormsHost>
		<ui:Label x:Name="labelSigNote" Width="300" Height="34" Margin="135,298,0,0" Text="Any new version of the letter clears the signature." />
		<ui:GroupBox x:Name="groupPdf" Width="420" Height="62" Margin="135,340,0,0" Text="Copy in the Imaging module">
			<ui:Label x:Name="labelImageCat" Width="100" Height="18" Margin="6,26,0,0" Text="Image category" HAlign="Right" />
			<ui:ComboBox x:Name="comboImageCat" Width="160" Height="21" Margin="110,24,0,0" />
			<ui:Button x:Name="butSavePdf" Width="120" Height="24" Margin="285,22,0,0" Text="Save PDF Copy" Click="butSavePdf_Click" />
		</ui:GroupBox>
		<ui:Button x:Name="butAudit" Width="92" VerticalAlignment="Bottom" Height="24" Margin="12,0,0,12" Text="Audit Trail" Click="butAudit_Click" />
		<ui:Button x:Name="butSave" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,12,12" Text="_Save" Click="butSave_Click" />
	</Grid>
</local:FrmODBase>
