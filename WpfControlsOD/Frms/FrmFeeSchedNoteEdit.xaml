<local:FrmODBase x:Class="OpenDental.FrmFeeSchedNoteEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="520" Height="400"
             Text="Fee Schedule Note Edit" MinMaxBoxes="False">
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelFeeSched" Width="480" Height="18" Margin="12,12,0,0" Text="Fee Schedule" VAlign="Center" />
		<ui:Label x:Name="labelDate" Width="90" Height="18" Margin="12,41,0,0" Text="Date" HAlign="Right" VAlign="Center" />
		<ui:TextVDate x:Name="textVDateEntry" Width="100" Height="20" Margin="106,40,0,0" />
		<ui:Label x:Name="labelClinics" Width="90" Height="18" Margin="12,69,0,0" Text="Clinics" HAlign="Right" VAlign="Center" />
		<ui:ComboClinic x:Name="comboClinics" Width="230" Height="21" Margin="106,68,0,0" IsMultiSelect="True" ShowLabel="False" />
		<ui:Label x:Name="labelClinicsAll" Width="160" Height="18" Margin="340,69,0,0" Text="(none selected = all clinics)" VAlign="Center" />
		<ui:Label x:Name="labelNote" Width="90" Height="18" Margin="12,97,0,0" Text="Note" HAlign="Right" VAlign="Center" />
		<ui:TextBox x:Name="textNote" Width="390" Height="200" Margin="106,96,0,0" IsMultiline="True" />
		<ui:Button x:Name="butDelete" Width="80" VerticalAlignment="Bottom" Height="26" Margin="12,0,0,12" Text="_Delete" Icon="DeleteX" Click="butDelete_Click" />
		<ui:Button x:Name="butSave" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="26" Margin="0,0,12,12" Text="_Save" Click="butSave_Click" />
	</Grid>
</local:FrmODBase>
