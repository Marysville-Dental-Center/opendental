<local:FrmODBase x:Class="OpenDental.FrmEFormInsPickExisting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental"
             xmlns:ui="clr-namespace:WpfControls.UI"
             mc:Ignorable="d"
             Width="560" Height="360"
             Text="Pick Existing Insurance" MinMaxBoxes="False" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelHead" Height="18" Margin="24,10,24,0" Text="Pick insurance that someone in your family already has" HorizontalAlignment="Stretch" />
		<ui:ListBox x:Name="listIns" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,32,28,72" />
		<ui:Button x:Name="butOK" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,109,26" Text="_OK" Click="butOK_Click" />
		<ui:Button x:Name="butCancel" HorizontalAlignment="Right" Width="75" VerticalAlignment="Bottom" Height="24" Margin="0,0,28,26" Text="Cancel" Click="butCancel_Click" />
	</Grid>
</local:FrmODBase>
