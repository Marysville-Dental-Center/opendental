<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CodeBase</RootNamespace>
    <AssemblyName>CodeBase</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <DocumentationFile>bin\Release\CodeBase.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\Required dlls\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>..\Required dlls\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Tao.OpenGl, Version=0.0.0.0, Culture=neutral, PublicKeyToken=1ca010269a4501ef">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Required dlls\Tao.OpenGl.dll</HintPath>
    </Reference>
    <Reference Include="Tao.Platform.Windows, Version=1.0.0.3, Culture=neutral, PublicKeyToken=701104b2da67a104">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Required dlls\Tao.Platform.Windows.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="Controls\ODWebView2.Designer.cs">
      <DependentUpon>ODWebView2.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\PrintPanel.Designer.cs">
      <DependentUpon>PrintPanel.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\FormProgressExtended.designer.cs">
      <DependentUpon>FormProgressExtended.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\FormProgressStatus.designer.cs">
      <DependentUpon>FormProgressStatus.cs</DependentUpon>
    </Compile>
    <Compile Update="Progress\ODProgressBar.designer.cs">
      <DependentUpon>ODProgressBar.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The class-based resource names (CodeBase.PrintPanel.resources, ...) come from DependentUpon. -->
    <EmbeddedResource Update="Controls\PrintPanel.resx">
      <DependentUpon>PrintPanel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\FormProgressExtended.resx">
      <DependentUpon>FormProgressExtended.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\FormProgressStatus.resx">
      <DependentUpon>FormProgressStatus.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Progress\ODProgressBar.resx">
      <DependentUpon>ODProgressBar.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Utilities\MsgBoxCopyPaste.resx">
      <DependentUpon>MsgBoxCopyPaste.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
