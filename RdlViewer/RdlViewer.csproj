<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    fyiReporting RDL Project 2.9.3 viewer control, LGPL 2.1 or later. OpenPmsDental.csproj builds it from this source and ships the result, in
    place of the prebuilt RdlViewer.dll it used to reference (package RDL-SRC, docs/port-notes/RDL-SRC.md).
    Changed by Open PMS - Dental contributors, 2026-11-01: targets .NET Framework 4.8 like the program (was 4.5).
    2026-11-08: SDK-style project (stage 1 of the .NET 10 move, docs/specs/net10-plan.md); every .cs and .resx file in this folder is compiled, as
    before.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RdlViewer</RootNamespace>
    <AssemblyName>RdlViewer</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <BaseAddress>285212672</BaseAddress>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- No symbols in a Release build. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- The class-based resource names (fyiReporting.RdlViewer.RdlViewer.resources, ...) come from DependentUpon. -->
    <EmbeddedResource Update="DataSourcePassword.resx">
      <DependentUpon>DataSourcePassword.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="DialogMessages.resx">
      <DependentUpon>DialogMessages.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="PageDrawing.resx">
      <DependentUpon>PageDrawing.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="RdlViewer.resx">
      <DependentUpon>RdlViewer.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdlEngine\RdlEngine.csproj" />
  </ItemGroup>
</Project>
