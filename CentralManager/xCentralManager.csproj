<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CentralManager.exe: manages the users, groups and passwords of several databases from one place (kept, decision 17; not shipped). The
    SDK's default globs compile every .cs file and embed every .resx file under this folder (bin\ and obj\ excepted); every file there was
    an item of the classic project. Only items with their own metadata are listed: the linked SharedAssemblyInfo.cs, the designer files and
    the class-based resource names (DependentUpon), the generated Resources and Settings files.
    AutoGenerateBindingRedirects is left to its default, on for an exe, as for the classic project: CentralManager.exe.config is app.config
    as it is.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CentralManager</RootNamespace>
    <AssemblyName>CentralManager</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\PasswordVaultWrapper\PasswordVaultWrapper.csproj" />
    <ProjectReference Include="..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="FormCentralConnectionEdit.designer.cs">
      <DependentUpon>FormCentralConnectionEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralConnectionGroupEdit.Designer.cs">
      <DependentUpon>FormCentralConnectionGroupEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralConnectionGroups.Designer.cs">
      <DependentUpon>FormCentralConnectionGroups.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralConnections.Designer.cs">
      <DependentUpon>FormCentralConnections.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralGroupPermEdit.Designer.cs">
      <DependentUpon>FormCentralGroupPermEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralManager.Designer.cs">
      <DependentUpon>FormCentralManager.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralPasswordChange.designer.cs">
      <DependentUpon>FormCentralPasswordChange.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralPasswordCheck.designer.cs">
      <DependentUpon>FormCentralPasswordCheck.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralPatientSearch.Designer.cs">
      <DependentUpon>FormCentralPatientSearch.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralPatientTransfer.Designer.cs">
      <DependentUpon>FormCentralPatientTransfer.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralProdInc.Designer.cs">
      <DependentUpon>FormCentralProdInc.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralReportSetup.Designer.cs">
      <DependentUpon>FormCentralReportSetup.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralSecurity.Designer.cs">
      <DependentUpon>FormCentralSecurity.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralUserEdit.Designer.cs">
      <DependentUpon>FormCentralUserEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralUserGroupEdit.Designer.cs">
      <DependentUpon>FormCentralUserGroupEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralUserGroups.Designer.cs">
      <DependentUpon>FormCentralUserGroups.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralUserPasswordEdit.Designer.cs">
      <DependentUpon>FormCentralUserPasswordEdit.cs</DependentUpon>
    </Compile>
    <Compile Update="FormCentralUserSettings.Designer.cs">
      <DependentUpon>FormCentralUserSettings.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="FormCentralChooseDatabase.resx">
      <DependentUpon>FormCentralChooseDatabase.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralConnectionEdit.resx">
      <DependentUpon>FormCentralConnectionEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralConnectionGroupEdit.resx">
      <DependentUpon>FormCentralConnectionGroupEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralConnectionGroups.resx">
      <DependentUpon>FormCentralConnectionGroups.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralConnections.resx">
      <DependentUpon>FormCentralConnections.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralGroupPermEdit.resx">
      <DependentUpon>FormCentralGroupPermEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralLogOn.resx">
      <DependentUpon>FormCentralLogOn.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralManager.resx">
      <DependentUpon>FormCentralManager.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralPasswordChange.resx">
      <DependentUpon>FormCentralPasswordChange.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralPasswordCheck.resx">
      <DependentUpon>FormCentralPasswordCheck.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralPatientSearch.resx">
      <DependentUpon>FormCentralPatientSearch.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralPatientTransfer.resx">
      <DependentUpon>FormCentralPatientTransfer.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralProdInc.resx">
      <DependentUpon>FormCentralProdInc.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralReportSetup.resx">
      <DependentUpon>FormCentralReportSetup.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralSecurity.resx">
      <DependentUpon>FormCentralSecurity.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralUserEdit.resx">
      <DependentUpon>FormCentralUserEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralUserGroupEdit.resx">
      <DependentUpon>FormCentralUserGroupEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralUserGroups.resx">
      <DependentUpon>FormCentralUserGroups.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralUserPasswordEdit.resx">
      <DependentUpon>FormCentralUserPasswordEdit.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormCentralUserSettings.resx">
      <DependentUpon>FormCentralUserSettings.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
