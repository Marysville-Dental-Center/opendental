<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DocumentationBuilder.exe: Open Dental's documentation tool (kept, decision 17; not shipped). It writes the schema documentation of the
    business library's table types (OpenDentalDocumentation.xml, and the diff against a previous version), the unit test documentation and
    the preference documentation. The SDK's default globs compile every .cs file and embed every .resx file under this folder (bin\ and obj\
    excepted); only items with their own metadata are listed: the form's designer file and its class-based resource name (DependentUpon),
    the generated Resources and Settings files.
    The program is a project reference, as in CentralManager, so the tool always gets the OpenPmsDental build of its own configuration (and
    OpenPmsDental.dll on .NET 10); the legacy UnitTests project stays a project reference too.
    AutoGenerateBindingRedirects is left to its default, on for an exe, as for the classic project.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DocumentationBuilder</RootNamespace>
    <AssemblyName>DocumentationBuilder</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <!-- The classic Release|x86 configuration did not optimize. -->
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\UnitTests\UnitTests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <!--
      The tool's data files stay out of the items, as in the classic project file: the documents it writes (OpenDentalDocumentation.xml,
      OpenDentalDiffDocumentation.xml, UnitTestsDocumentation.xml), their stylesheets and the preference tables it wrote for earlier
      versions (PreferenceTable). It reads and writes them in this folder, as ..\..\ from its output folder (bin\Debug or bin\Release,
      which the flat output layout keeps), never as copies in the output folder.
    -->
    <None Remove="OpenDentalDiffDocumentation.xml" />
    <None Remove="OpenDentalDiffDocumentation.xsl" />
    <None Remove="OpenDentalDocumentation.xml" />
    <None Remove="OpenDentalDocumentation.xsl" />
    <None Remove="PreferenceTable\Pref233.html" />
    <None Remove="PreferenceTable\Pref241.html" />
    <None Remove="PreferenceTable\Pref242.html" />
    <None Remove="PrefsDocumentation.xsl" />
    <None Remove="UnitTestsDocumentation.xml" />
    <None Remove="UnitTestsDocumentation.xsl" />
  </ItemGroup>
</Project>
