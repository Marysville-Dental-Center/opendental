<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    DevDbTool: builds a local development database for this codebase from the seed dump in
    UnitTests\Resources\dump.txt, then upgrades it with the convert scripts in OpenPmsDentalBusiness.
    Run it through tools\New-DevDatabase.ps1, which builds it on its own. With export-init-sql it also writes
    db\init\new-database.sql, the SQL file that initializes a new database (tools\New-InitSql.ps1). It is in OpenDental.sln
    and OpenDental.Local.slnf, so that every solution build compiles it, catches a break early and builds it for the test
    that regenerates that file (tests\ForkMigrationTests\InitSqlRegenerationTests.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DevDbTool</RootNamespace>
    <AssemblyName>DevDbTool</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Platforms>x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ODCrypt\xODCrypt.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
