<Project>
  <!-- Tests for tools\SyntheticData. Unit tests run anywhere; the database tests use scratch databases named synth_test_* on the local
       MariaDB (127.0.0.1:3306, root, password from SYNTH_DB_PASSWORD) and are inconclusive when no server is reachable. -->
  <PropertyGroup>
    <!--
      The project is outside tests\, so MSBuild would import the repository's Directory.Build.props for it, not tests\Directory.Build.props,
      which holds what every test project shares. It names that file instead, before Sdk.props, which imports it; tests\Directory.Build.props
      imports the repository's own first, so each of the two is imported once. Sdk.props and Sdk.targets are therefore imported explicitly.
    -->
    <DirectoryBuildPropsPath>$(MSBuildThisFileDirectory)..\..\..\tests\Directory.Build.props</DirectoryBuildPropsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyntheticData.csproj" />
    <!-- Only to cross-check the enum numbers that already existed in 24.3; the tool itself does not use the business layer. -->
    <ProjectReference Include="..\..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
