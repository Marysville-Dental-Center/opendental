<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SyntheticData: fills a copy of the Open Dental 25.3.48 schema with deterministic, entirely fictional practice data, and writes
    validation reports (row counts, per-table and per-column checksums, business totals) for the adoption rehearsal (M1-Z).
    It talks only to a MariaDB/MySQL server on this machine and does not depend on OpenPmsDentalBusiness, because the schema it fills
    is newer than the business layer. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SyntheticData</RootNamespace>
    <AssemblyName>SyntheticData</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Platforms>x86</Platforms>
    <!-- Every source file under this folder except the test project (its own project, in the sub folder) and build output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);SyntheticData.Tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- Newtonsoft.Json, the version of Directory.Packages.props. -->
    <PackageReference Include="Newtonsoft.Json" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="sql\business-totals.sql;allowed-differences.adoption.json" />
    <Content Include="sql\business-totals.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="allowed-differences.adoption.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
