<?xml version="1.0" encoding="utf-8"?>
<!--
  AdoptionValidation: the M1-Z switch-gate rehearsal (docs/specs/port-backlog.md, section M1-Z). It generates a synthetic Open Dental
  25.3.48 database with tools\SyntheticData, records its validation baseline, backs it up and restores a copy, adopts the copy with the
  business layer's adoption tool (M1-03), runs the fork migration and the schema verifier (M1-01), rehashes, and validates the result:
  row counts, checksums, business totals, a load-and-save round trip of every 24.4-25.3 column through OpenDentBusiness, the version
  sentinels and an Open Dental-style startup check. Synthetic data on the local server only. See README.md.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{7C3D34FF-42A5-4E61-9F33-54D3DDF4AD8C}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdoptionValidation</RootNamespace>
    <AssemblyName>AdoptionValidation</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>8.0</LangVersion>
    <!-- MySqlConnector and the business layer need binding redirects, as OpenDental.exe gets them. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every source file under this folder except the test project and build output. -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;AdoptionValidation.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="README.md" />
    <None Include="Invoke-AdoptionRehearsal.ps1" />
    <!-- Runbook step 0.6: copied next to the program, so the folder copied to the database server (<tools> in the runbook) has it. -->
    <None Include="Invoke-RunbookDryRun.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SyntheticData\SyntheticData.csproj">
      <Project>{7C3E9A51-2B64-4D8F-A1E0-5F4B6C8D2E17}</Project>
      <Name>SyntheticData</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj">
      <Project>{18F7BC78-4B99-48D3-A1F1-0D13A63E3CF9}</Project>
      <Name>xCodeBase</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj">
      <Project>{29C41020-4411-41F2-9061-9B71B5B32B5D}</Project>
      <Name>xDataConnectionBase</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\OpenDentBusiness\OpenDentBusiness.csproj">
      <Project>{3D0FC76E-803C-4DE2-BDB1-47D63A4E2357}</Project>
      <Name>OpenDentBusiness</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
