<Project>
  <!-- Tests for tools\AdoptionValidation (the M1-Z rehearsal). Unit tests run anywhere; the integration tests run the whole rehearsal (small
       preset, two runs) on scratch databases named synth_m1z_t* on the local MariaDB (127.0.0.1:3306, root, password from SYNTH_DB_PASSWORD),
       drop them afterwards, and are inconclusive when no server or no 25.3.48 schema source is available. -->
  <PropertyGroup>
    <!--
      The project is outside tests\, so MSBuild would import the repository's Directory.Build.props for it, not tests\Directory.Build.props,
      which holds what every test project shares. It names that file instead, before Sdk.props, which imports it; tests\Directory.Build.props
      imports the repository's own first, so each of the two is imported once. Sdk.props and Sdk.targets are therefore imported explicitly.
    -->
    <DirectoryBuildPropsPath>$(MSBuildThisFileDirectory)..\..\..\tests\Directory.Build.props</DirectoryBuildPropsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdoptionValidation.csproj" />
    <ProjectReference Include="..\..\SyntheticData\SyntheticData.csproj" />
    <ProjectReference Include="..\..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
