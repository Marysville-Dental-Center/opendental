<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-PRINT (statements, sheets, printing and grid export: Open Dental 24.4 Transaction History export, 25.1 sheet
       copies to Imaging, 25.3 statement e-mail names, inserter barcode, Edit CheckBox cleanup, Print Options window and Export .csv/.txt).
       Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password), built from the 24.3.63 seed and the
       fork migrations, and are skipped (inconclusive) when it does not answer. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
