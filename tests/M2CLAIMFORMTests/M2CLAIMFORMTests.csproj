<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-CLAIMFORM (docs/specs/port-backlog.md): the built-in Denti-Cal DC217_2019 claim form. Layout tests need no
       database. Database tests build one scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way
       tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, and use synthetic data only. They are skipped (inconclusive) when
       the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the claim printout (FormClaimPrint) and the claim form field list (FormClaimFormItemEdit). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
