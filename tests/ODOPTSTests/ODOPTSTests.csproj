<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for ODOPTS: the eight Open Dental 25.3 options this program built (docs/port-notes/ODOPTS.md), read and written under Open Dental's
       own setting names. Database tests use one scratch database per run named test_odopts_* on the local MariaDB (127.0.0.1:3306, root, blank
       password) with the current reference schema, dropped afterwards, and are skipped (inconclusive) when it does not answer or when
       ODOPTS_TEST_DB=skip. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The made-up patients, plans and claims of the database tests. -->
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- The Perio Chart grid (ContrPerio) lives in OpenPmsDental.exe; its cell positions (ColRow) in WpfControlsOD. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
