<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-DBM: the Database Maintenance checks and tools of Open Dental 24.4 to 25.4 (Raw Emails white space,
       EmailmessageInvalidCharactersInBodyText, Invalid Characters (GDI+), Notes White Space on the Tools tab, EmployeeMissingSupervisor and
       Create Documents From Base64 Notes). Each run builds a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the
       way tools/New-DevDatabase.ps1 does, upgrades it with the fork migration runner, and uses synthetic data only. Database tests are skipped
       (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
