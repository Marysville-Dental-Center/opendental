<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-INSPLAN (docs/specs/port-backlog.md): the 26.1 layout of the Edit Insurance Plan window, the 25.4 wording of
       its write-off overrides, and the PlanNum in the audit entry of a dropped plan. The layout tests read FormInsPlan.designer.cs and need no
       database. The window tests build the real window (never shown) on a scratch database on the local MariaDB (127.0.0.1:3306, root, blank
       password), built like tools/New-DevDatabase.ps1 with synthetic rows only, and are skipped (inconclusive) when it does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <None Include="Data\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For FormInsPlan, which the window tests build without showing it. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
