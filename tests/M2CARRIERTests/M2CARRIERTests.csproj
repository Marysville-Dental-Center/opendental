<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-CARRIER (docs/specs/port-backlog.md): carrier preauthorization flags (26.1) and long insurance edit log
       values (25.4). Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) with a unique per-run
       name, filled with synthetic rows only, dropped afterwards, and skipped (inconclusive) when the server does not answer or when
       M2CARRIER_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
