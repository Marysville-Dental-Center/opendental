<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-NOTES (docs/specs/port-backlog.md): the larger Group Note window (25.4), Procedure Note Merge (25.4) and the
       group note's second signature (26.1). Rule tests need nothing; the signature tests use the business layer's signature box without showing it.
       Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password), filled with synthetic rows only, and are
       skipped (inconclusive) when it does not answer, or when M2NOTES_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
