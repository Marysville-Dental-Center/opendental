<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- Tests for backlog package M2-SHEETS (Open Dental 25.4): sheets in non-Latin scripts on screen, in print and in PDFs, and the duplicate
       field warning of the Sheet Def editor. Most tests need no database: they draw into PDFs and bitmaps in memory, drive the Sheet Def editor's key and mouse
       handlers in memory (the window is never shown) and read the window sources.
       The Unicode round-trip tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) built from the 26.1.70
       reference schema, with synthetic data only, dropped afterwards; they are skipped (inconclusive) when the server does not answer or when
       FORKMIGRATION_TEST_DB=skip. Tests that need a Windows font this computer lacks are inconclusive. Every .cs file under this folder is
       compiled. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{26DEE1D0-7AA8-4538-A60E-7CE4C7568FCA}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>M2SHEETSTests</RootNamespace>
    <AssemblyName>M2SHEETSTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>8.0</LangVersion>
    <ProjectTypeGuids>{3AC096D0-A1C2-E12C-1390-A8335801FDAB};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <IsCodedUITest>False</IsCodedUITest>
    <TestProjectType>UnitTest</TestProjectType>
    <!-- MySqlConnector and the business layer need binding redirects, as OpenPmsDental.exe gets them. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSTest v1, found through the search path added in Directory.Build.targets. -->
    <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" />
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>..\..\Required dlls\PdfSharp.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj">
      <Project>{18F7BC78-4B99-48D3-A1F1-0D13A63E3CF9}</Project>
      <Name>xCodeBase</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj">
      <Project>{29C41020-4411-41F2-9061-9B71B5B32B5D}</Project>
      <Name>xDataConnectionBase</Name>
    </ProjectReference>
