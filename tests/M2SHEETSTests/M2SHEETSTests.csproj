      <Project>{8136317D-C936-49B6-9E31-D90F02D2F207}</Project>
      <Name>OpenPmsDental</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
