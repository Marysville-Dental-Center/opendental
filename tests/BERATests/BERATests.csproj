<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-ERA: matching an ERA to a claim despite a fee or date mismatch (24.4), auto split of ERA claims with denial
       CARCs (25.1), more logic for "Don't auto-process claims w/ these CARCs" (25.2), and the ERA Claims Paid grid in Display Fields (25.3.78 and
       25.4). Rule, grid and message tests need no database. Database tests build a scratch database on the local MariaDB (127.0.0.1:3306, root,
       blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, and use synthetic data only (made-up
       Z codes, made-up payer and patients, a hand-built 835). They are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
