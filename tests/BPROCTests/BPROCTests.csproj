<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-PROC: Procedure Code Tools (D Codes and CDA Codes imports of a code file the office supplies, Reset Code Groups),
       the Provider and Clinic filters of More Fees and the Fee Tools tabs. Parser, plan and layout tests need no database. Database tests build a
       scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the
       fork migration runner, and use synthetic data only (made-up codes and descriptions; no ADA or CDA code text). They are skipped
       (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- For the layout tests of Fee Tools, Procedure Code Tools and More Fees: the forms are built in memory and never shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
