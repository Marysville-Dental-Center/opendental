<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-INSH: two Insurance History dates per category (25.1), editing and removing them (25.2), the Edit Benefit
       window rules (25.2), the In Net column of the Insurance Plans list (25.3) and the Blue Book "Provider Fee" rule (25.3). Rule tests need
       no database. Database tests build a scratch database on the local MariaDB
       (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, and use
       synthetic data only (made-up Z codes). They are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
