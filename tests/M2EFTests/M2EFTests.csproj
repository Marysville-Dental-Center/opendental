<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for eForms at the Open Dental 25.4 and 26.1 level (package M2-EF in docs/specs/port-backlog.md): patient fields in eForms, rich text
       paste into labels, importing several eForms at once, the signature time, the date submitted on sheets and eForms, and the Audit Trail entry
       for a deleted eForm. Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) with unique per-run
       names, synthetic rows only, dropped afterwards; they are skipped (inconclusive) when the server does not answer or M2EF_TEST_DB=skip.
       WPF tests run on their own STA thread. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
