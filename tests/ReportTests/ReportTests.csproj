<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the 24.4 to 25.2 standard reports (package A-RPT in docs/specs/port-backlog.md): the Procedures and Production by Procedure
       queries, the Insurance Pending Supplementals query, the displayreport rows and the report dispatcher. Database tests use scratch databases
       with synthetic rows on the local MariaDB. Every .cs file under this folder is compiled.
       Package RDL-SRC (docs/port-notes/RDL-SRC.md): the RDL reports that load ODR.dll, rendered by RdlEngine and RdlViewer built from source,
       on a scratch database built from the 24.3.63 seed and the fork migrations (TestDb.cs of the fork migration tests, names forkmig_). -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
    <!-- The rule for tests that check a built file: inconclusive when it is not built, a failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The RDL engine and viewer the program uses, and ODR.dll, which the report definitions load as their code module from this folder. -->
    <ProjectReference Include="..\..\ODR\xODR.csproj" />
    <ProjectReference Include="..\..\RdlEngine\RdlEngine.csproj" />
    <ProjectReference Include="..\..\RdlViewer\RdlViewer.csproj" />
  </ItemGroup>
</Project>
