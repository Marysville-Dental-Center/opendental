<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-RECUR: the e-mail sent when a recurring charge is declined (25.4) and the preference that allows or prevents
       backdated repeating charges (26.1). Each run builds a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way
       tools/New-DevDatabase.ps1 does, upgrades it with the fork migration runner (which seeds the 25.4 and 26.1 preferences), and uses synthetic
       data only. No e-mail leaves the computer: the tests replace the sender. Database tests are skipped (inconclusive) when the server does not
       answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- HttpMessageHandler: PaySimple requests go to a fake handler (PaySimpleDeclineTests). -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
