<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the remembered SSH host keys (docs/specs/ssh-host-keys.md): the host key check with a fake store and with a real SSH.NET client
       against an in-process fake SSH server on 127.0.0.1 (a changed key is refused before authentication), the business layer (first use,
       refusals, accepting and removing keys, their audit entries, the Security Admin checks), the migration step on scratch databases, and the
       wiring of every SSH path. Database tests use scratch MariaDB databases named test_fussh_* with synthetic rows only; host keys are generated
       for each run with BouncyCastle. No test reaches the internet. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- BouncyCastle: the tests generate host keys with it, and the fake SSH server does its key exchange with it (SSH.NET uses it itself). -->
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>..\..\Required dlls\BouncyCastle.Cryptography.dll</HintPath>
    </Reference>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="Renci.SshNet">
      <HintPath>..\..\Required dlls\Renci.SshNet.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalStorage\OpenPmsDentalStorage.csproj" />
  </ItemGroup>
</Project>
