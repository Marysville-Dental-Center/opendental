<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the Perio Chart (package B-PERIO in docs/specs/port-backlog.md): the auto Att Ging row, the implant marker after removal, the
       "Recession" term option and the birthdate on the printed Graphical Perio Chart. Database tests use a scratch MariaDB database with the
       current reference schema (Open Dental 26.1.70) and synthetic rows only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The Perio Chart grid (ContrPerio) lives in OpenPmsDental.exe; its cell positions (ColRow) in WpfControlsOD. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
