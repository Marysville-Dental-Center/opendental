<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-SHELL (docs/specs/port-backlog.md): [SelectedProcNums], the module switch blur, the File Monitor, the non-modal
       Ortho Chart, bold medical rows and the removed DentalXChange credit score bridge. Database tests use a scratch database with a unique
       per-run name on the local MariaDB (127.0.0.1:3306, root, blank password), filled with synthetic rows only and dropped afterwards; they are
       skipped (inconclusive) when the server does not answer, or when BSHELL_TEST_DB=skip. No window is ever shown.
       Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- FrmMessageReplacements (WpfControlsOD) derives from WPF types; the replacement list is read without opening the window. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the module switch cover (built, never shown) and the program link replacement list. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
