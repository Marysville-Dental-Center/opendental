<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package V-BRIDGE1: the Overjet (25.1), DTX Studio and DTX Studio Acquire (25.2) program links and the Insurance Answers
       Plus web launcher (25.2). Nothing starts a browser or a program and nothing contacts a vendor: the launch rules return the address or
       command line, which the tests check. The row tests build a scratch database on the local MariaDB (127.0.0.1:3306, root, blank
       password) the way tools/New-DevDatabase.ps1 does and drop it afterwards; they are skipped (inconclusive) when the server does not answer,
       or when FORKMIGRATION_TEST_DB=skip. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
