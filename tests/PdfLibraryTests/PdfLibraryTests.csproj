<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the PDFsharp and MigraDoc 6.5 update (package LIB-PDF) and their build from empira's source (package SRC-REF): the AGPL licence
       selected with no key, no network call, no message and no mark on the pages, through the open licence check that replaces empira's closed
       PdfSharp.License.dll; the git submodule and its pin, the project files of third-party\build against the upstream ones, the built
       assemblies' identities, the source archive of a release (git, offline); the release lists and the licence texts; and representative PDFs
       (sheets, MigraDoc documents with tables, images and charts, merged and split PDFs, images, fonts, print preview) saved and read back with
       PdfReader.
       The statement tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password; the name starts with
       test_srcref_pdf_), with synthetic data only, dropped afterwards; they are inconclusive when the server does not answer or when
       LIBPDF_TEST_DB=skip. Tests that need a Windows font or printer this computer lacks are inconclusive. Every .cs file under this folder
       is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- The source archive (SourceArchiveTests). -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third-party\build\MigraDoc.DocumentObjectModel\MigraDoc.DocumentObjectModel.csproj" />
    <ProjectReference Include="..\..\third-party\build\MigraDoc.Rendering-gdi\MigraDoc.Rendering-gdi.csproj" />
    <ProjectReference Include="..\..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- MigraDocHelper, MigraDocPrintDocument and the licence list. No window is shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
