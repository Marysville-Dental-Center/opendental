<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package A-SHEET: check printing with the Check sheet type (25.3), secondary-insurance static text (24.4) and the
       hospitalization dates on the 1500 claim form (24.4). Rule tests need no database. Database tests build one scratch database on the local
       MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, and use
       synthetic data only. They are skipped (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip.
       Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- As in the classic project, TRACE in both configurations and no DEBUG symbol in Debug (and no RELEASE in Release): the SDK adds
         only its framework symbols. -->
    <DefineConstants>TRACE</DefineConstants>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
