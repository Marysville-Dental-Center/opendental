<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package S0-F of the .NET 10 plan: the fixes for the issues the stage 0 window checks found. Deleting a document also deletes its
       thumbnail; the program's exit always ends the process; the log-off and close prompt counts down only while nobody uses it, and its X is No;
       the Email Authentication box of Edit Email Address fits what it shows. The thumbnail tests use one scratch database on the local MariaDB
       (127.0.0.1:3306, root, blank password) whose name starts with s0f_ and is unique to the run, built from db/init/new-database.sql and the
       fork migrations and dropped afterwards, and a scratch A-to-Z folder in the temp folder; they are skipped (inconclusive) when the server does
       not answer or when S0F_TEST_DB=skip. No window of the program is shown. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- PresentationCore, PresentationFramework, System.Xaml and WindowsBase: InputBox (WpfControlsOD) is a WPF window class. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the layout of Edit Email Address (a static method) and the program's exit. No window of the program is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <!-- The table helpers (PatientT) of the thumbnail tests. -->
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- For InputBox, the prompt of log off and close (its countdown, without showing it). -->
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
