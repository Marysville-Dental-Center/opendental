<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the version guard, database adoption and the release channel (backlog M1-03, Risk R1; docs/release-process.md).
       Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) with synthetic data only, and are
       inconclusive when no server answers or RELEASEFLOW_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
    <!-- The rule for tests that check a built file: inconclusive when it is not built, a failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
    <!-- The packages of a lock file and the files the build copies from them (S2-4 of the .NET 10 move: the release compares each package file
         with its package). -->
    <Compile Include="..\ProjectFileTests\NuGetFiles.cs">
      <Link>NuGetFiles.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
