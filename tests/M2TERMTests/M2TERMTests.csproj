<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the Open Dental 25.4 "UCR" to "Standard Provider Fee" wording (package M2-TERM in docs/specs/port-backlog.md): the shown text in
       the owned windows, reports and enum descriptions, that the new text fits its controls, the report headers against the data columns they
       sit over, the report export keys that stay as they were, and the Blue Book estimate log. Database tests use a scratch MariaDB database with a unique per-run name and synthetic rows only.
       Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the report export keys (OpenPmsDental.ReportingComplex.QueryObject's export table). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
