<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CryptoTests: unit tests for CodeBase.Secrets, CodeBase.TamperHash and ODCrypt. No database needed. Every .cs file under this folder is
    compiled.
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <!-- The solution also builds this project as Any CPU; it compiles for x86 all the same (PlatformTarget, the repository's
         Directory.Build.props). -->
    <!-- x86 like CodeBase, which holds the Secrets and TamperHash code under test. -->
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\ODCrypt\xODCrypt.csproj" />
  </ItemGroup>
</Project>
