<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Insurance History from code groups (package M2-HIST in docs/specs/port-backlog.md, Open Dental 26.1): the rows from code
       groups, reading and entering history, the eligibility (271) mapping, frequency codes, the Code Group Edit rules and the migration of the
       ten InsHist*Codes preferences. Rule tests need no database. Database tests use scratch MariaDB databases with unique per-run names and
       synthetic rows only (made-up Z codes), and drop them afterwards. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- For the layout test of the Insurance History window: the form is built in memory and never shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
