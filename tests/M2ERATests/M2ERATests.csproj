<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-ERA: the PreAuth and $0 filters of the ERAs Automatically Processed report (Open Dental 25.4) and the link from
       received claimprocs to the exact ERA claim, claimproc.Etrans835AttachNum (Open Dental 26.1). Filter and link rules need no database.
       Database tests build a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does,
       upgrade it with the fork migration runner, and use synthetic data only (made-up Z codes, made-up payer and patients, hand-built 835s). They
       are skipped (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is
       compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
