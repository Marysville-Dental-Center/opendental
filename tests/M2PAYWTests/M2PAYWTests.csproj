<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-PAYW: the 25.4 preference that limits manual income transfers to patient payments, and the 26.1 Invoice
       filter on the Payment window's Outstanding Charges. The rule tests need no database. The database tests build a scratch database on the
       local MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner,
       use synthetic data only and drop it afterwards. They are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
