<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library updates (first step: the shared support assemblies): every reference between the library files (those of "Required dlls"
       and, since S2-4 of the .NET 10 move, the NuGet packages' own files at the lock files' versions) resolves in every program's config, no
       redirect names a version that is not there, the built programs and tests load those very files, and the release ships exactly the ones
       the programs need. Reads assembly metadata with Mono.Cecil and loads none of the files it checks. No database, device or network is
       needed. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Reads assembly references without loading the assemblies. The NuGet package, from the offline package folder (nuget.config), at
         the version of Directory.Packages.props. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
    <!-- The rule for tests that check a built file: inconclusive when it is not built, a failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
    <!-- The packages of a lock file and the files the build copies from them (S2-4 of the .NET 10 move). -->
    <Compile Include="..\ProjectFileTests\NuGetFiles.cs">
      <Link>NuGetFiles.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
