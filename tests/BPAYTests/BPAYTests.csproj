<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-PAY (docs/specs/port-backlog.md): the retired Pay Plan charge logic choice, completed amount and down payment
       audit entries, payment plans ignoring the global lock, Payment Plan Prepay splits on patient payment plans and the other paysplit attach cases.
       Each run builds a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does,
       upgrades it with the fork migration runner, and uses synthetic data only. Database tests are skipped (inconclusive) when the server does not
       answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For PayPlanL.MakeSecLogEntries and PayPlanL.AdvanceAuditBaseline (static methods). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
