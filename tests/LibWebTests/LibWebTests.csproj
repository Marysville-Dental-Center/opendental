<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- Tests for the library update package LIB-WEB (docs/port-notes/LIB-WEB.md): WebView2 in place of the Internet Explorer WebBrowser control.
       A static check that no IE browser type, mshtml or SHDocVw interop or IE emulation key is left in shipped code; unit tests of the WebView2
       rules (profile folder, link handling, context menu, cookies, a runtime that will not start) and of the HTML the program builds (encoding,
       a CCD as XML with no stylesheet run in the program, the wiki's links, the preference details page); and a WebView2 smoke test in a small
       off-screen window, which is inconclusive only when the WebView2 Runtime is missing or does not start here, or when LIBWEB_SKIP_WEBVIEW2=1.
       It uses only local pages and .invalid addresses, whose navigations are cancelled before any request goes out. No database. Every .cs
       file under this folder is compiled. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{50488924-88DE-4F05-9C09-DA08CC574AE6}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>LibWebTests</RootNamespace>
    <AssemblyName>LibWebTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>8.0</LangVersion>
    <ProjectTypeGuids>{3AC096D0-A1C2-E12C-1390-A8335801FDAB};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <IsCodedUITest>False</IsCodedUITest>
    <TestProjectType>UnitTest</TestProjectType>
    <!-- The program and the business layer need binding redirects, as OpenPmsDental.exe gets them. Generate LibWebTests.dll.config. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSTest v1, found through the search path added in Directory.Build.targets. -->
    <Reference Include="Microsoft.VisualStudio.QualityTools.UnitTestFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" />
    <!-- Reads the built assemblies' type references without loading them. The NuGet package UnitTests restores (UnitTests\packages.config). -->
    <Reference Include="Mono.Cecil, Version=0.10.3.0, Culture=neutral, PublicKeyToken=50cebf1cceb9d05e, processorArchitecture=MSIL">
      <HintPath>..\..\packages\Mono.Cecil.0.10.3\lib\net40\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\..\Required dlls\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>..\..\Required dlls\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The native loader of the WebView2 SDK (x86), which OpenPmsDental.exe also keeps next to itself. -->
    <None Include="..\..\Required dlls\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj">
      <Project>{18F7BC78-4B99-48D3-A1F1-0D13A63E3CF9}</Project>
      <Name>xCodeBase</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj">
      <Project>{29C41020-4411-41F2-9061-9B71B5B32B5D}</Project>
      <Name>xDataConnectionBase</Name>
    </ProjectReference>
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj">
      <Project>{3D0FC76E-803C-4DE2-BDB1-47D63A4E2357}</Project>
      <Name>OpenPmsDentalBusiness</Name>
    </ProjectReference>
    <!-- For FormWiki.ParseLink and FormWebBrowserPrefs.BuildHtml (static methods). No window of the program is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj">
      <Project>{8136317D-C936-49B6-9E31-D90F02D2F207}</Project>
      <Name>OpenPmsDental</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
