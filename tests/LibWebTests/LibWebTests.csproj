<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the library update package LIB-WEB (docs/port-notes/LIB-WEB.md): WebView2 in place of the Internet Explorer WebBrowser control.
       A static check that no IE browser type, mshtml or SHDocVw interop or IE emulation key is left in shipped code; unit tests of the WebView2
       rules (profile folder, link handling, context menu, cookies, a runtime that will not start) and of the HTML the program builds (encoding,
       a CCD as XML with no stylesheet run in the program, the wiki's links, the preference details page); and a WebView2 smoke test in a small
       off-screen window, which is inconclusive only when the WebView2 Runtime is missing or does not start here, or when LIBWEB_SKIP_WEBVIEW2=1.
       It uses only local pages and .invalid addresses, whose navigations are cancelled before any request goes out. EmailPreviewTemplateTests,
       moved out of the legacy UnitTests project (package S0-T of the .NET 10 plan), uses one scratch database on the local MariaDB (127.0.0.1,
       root, blank password) whose name starts with s0t_, built from the seed dump and dropped afterwards; it is inconclusive without the server.
       No other test uses a database. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- Reads the built assemblies' type references without loading them. The NuGet package, from the offline package folder (nuget.config). -->
    <PackageReference Include="Mono.Cecil" Version="0.10.3" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\..\Required dlls\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>..\..\Required dlls\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
    <!-- The scratch database of EmailPreviewTemplateTests (ScratchDb.cs). -->
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- PresentationCore, PresentationFramework, System.Xaml and WindowsBase: FrmMessageReplacements (WpfControlsOD) is a WPF window class. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
    <!-- The rule for tests that check a built file: inconclusive when it is not built, a failure with OPMS_REQUIRE_BUILD_OUTPUT=1. -->
    <Compile Include="..\ProjectFileTests\BuildOutput.cs">
      <Link>BuildOutput.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The native loader of the WebView2 SDK (x86), which OpenPmsDental.exe also keeps next to itself. -->
    <None Include="..\..\Required dlls\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For FormWiki.ParseLink and FormWebBrowserPrefs.BuildHtml (static methods). No window of the program is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <!-- The table helpers (PatientT, ReferralT, RecallT, PrefT, UserodT) of EmailPreviewTemplateTests. -->
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- For FrmMessageReplacements.GetReplacementFieldList (a static method of a WPF window class; no window is created). -->
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
