<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-EST, the insurance estimate engine: treatment plan estimates as of the scheduled appointment date (25.4) across
       benefit-year boundaries, the per-procedure Do Not Bill to Ins flag with its audit trail (25.4), teeth for exclusions (25.4) and age limits by
       tooth (26.1). Pure tests need no database. Database tests build a scratch database on the local MariaDB (127.0.0.1:3306, root, blank
       password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, use synthetic data only (made-up Z codes) and
       drop it afterwards. They are skipped (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under
       this folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
