<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the row-integrity hashes (backlog package A-HASH): insverify, insverifyhist and inssub SecurityHash, and the Database
       Maintenance method that rehashes the whole patient table. Synthetic data only.
       Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) and are skipped (inconclusive) when it
       does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch-database helper shared with the fork migration tests. -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
