<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package P262-PERIO (Open Dental 26.2 Perio Chart items 14 to 16): flags added to every site of the selected teeth, several cells
       selected in any editable data row, and the settings Show previous exams and Show previous probing values. The Perio Chart grid
       (ContrPerio) is created and driven off screen; the desktop client is never launched. Database tests use one scratch database on the local
       MariaDB (127.0.0.1:3306, root, blank password) whose name starts with test_p262perio_ and is unique to the run, with the current reference
       schema and synthetic rows only, dropped afterwards; they are skipped (inconclusive) when the server does not answer or when
       P262PERIO_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The Perio Chart grid (ContrPerio) lives in OpenPmsDental.exe; its cell positions (ColRow) in WpfControlsOD. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
