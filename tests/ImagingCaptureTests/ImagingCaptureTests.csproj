<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for ImagingCapture. They need no camera: the UVC layer is exercised through FakeUvcBackend, and the DirectShow
    declarations are checked for layout and vtable order. MSTest v1, like ImagingDeviceManagerTests. Run with
    vstest.console /Platform:x86. Every .cs file under this folder is compiled.
    The tests under Db\ are the capture track's database tests: they run the Od* stores, the hook's database path and a full mount save on
    one scratch MariaDB database (a 24.3.63 seed through the fork migration runner) with a unique per-run name, dropped afterwards, and a
    temporary A to Z folder. Synthetic data only. They are skipped (inconclusive) when the local MariaDB does not answer or when
    FORKMIGRATION_TEST_DB=skip; the other tests use no database.
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>Db\TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ImagingCapture\xImagingCapture.csproj" />
    <!-- CameraConfig tests read and write capture.ini through LocalCaptureConfig. -->
    <ProjectReference Include="..\..\ImagingDeviceManager\xImagingDeviceManager.csproj" />
    <!-- PatientBinding tests build ODEventArgs (CodeBase) and Patient tags (OpenPmsDentalBusiness). No database is used. -->
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The database tests (Db\): DataConnection, and the synthetic patients, providers, definitions and users of UnitTestsCore. -->
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
    <!-- DataValid.EventInvalid, which "Add standard templates" raises to tell the other computers about new mount definitions. -->
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
