<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package P262-SCHEMA: the Open Dental 26.1.70 to 26.2.0 schema step, the 26.2.0 reference schema, the generated CRUD of the new and
       changed tables and the 26.2 enum values. Database tests use scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password)
       whose names start with test_p262schema_ and are unique to the run, dropped afterwards; they are skipped (inconclusive) when the server does
       not answer or when P262_TEST_DB=skip. The checks against Open Dental's published database documents run when P262_OD_DOCS_DIR names a
       folder that holds them. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
