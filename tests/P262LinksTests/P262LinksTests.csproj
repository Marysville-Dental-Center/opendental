<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package P262-LINKS (Open Dental 26.2 items 44 to 47): the Allied Star Connect and OrthoComposite program links, the retired
       Trojan Express Collect link and its fork migration step, and the removed Suni support. Sample patients are synthetic; nothing is launched
       and no vendor is called. Database tests use one scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) whose name
       starts with test_p262links_ and is unique to the run, dropped afterwards; they are skipped (inconclusive) when the server does not answer
       or when P262LINKS_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <HintPath>..\..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
