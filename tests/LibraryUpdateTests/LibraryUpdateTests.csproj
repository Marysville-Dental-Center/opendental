<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library updates (tier 1: Newtonsoft.Json 13, MailKit and MimeKit 4, Google APIs 1.78, MSAL 4.92, SSH.NET 2026): the JSON the database
       stores stays byte-identical, MIME messages build and parse, POP3 receive and SMTP send work against in-process fake servers on 127.0.0.1
       (plain and TLS), SFTP paths and host keys are checked, and the removed libraries stay out. EmailMessagesTests holds the e-mail tests
       moved out of the legacy UnitTests project (package S0-T of the .NET 10 plan). The database tests use scratch databases named test_libt1_*
       and s0t_* on the local MariaDB and are inconclusive without it. No test reaches the internet. Every .cs file under this folder is
       compiled. -->
  <ItemGroup>
    <!-- BouncyCastle (the SFTP tests generate host keys with it; SSH.NET and MimeKit use it themselves), MailKit, MimeKit, Newtonsoft.Json
         and SSH.NET come as packages through the projects below. -->
    <!-- The Direct Project parser every downloaded email goes through (EmailMessages.RawEmailToIncomingMessage). -->
    <Reference Include="Health.Direct.Agent">
      <HintPath>..\..\Required dlls\Health.Direct.Agent.dll</HintPath>
    </Reference>
    <Reference Include="Health.Direct.Common">
      <HintPath>..\..\Required dlls\Health.Direct.Common.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalStorage\OpenPmsDentalStorage.csproj" />
    <!-- The table helpers (PrefT, PatientT, EmailMessageT and the others) of the e-mail tests moved out of the legacy UnitTests project. -->
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
