<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the EHR rebuild (docs/specs/ehr-rebuild-plan.md). Package EHR-0 adds the switch (Show Features and the Setup Wizard share one
       confirmation), the time check (the ForkTimeSyncMode setting, TimeSyncCheck, the NTP reply rules of NtpReply on synthetic RFC 5905
       packets, WindowsTime.TrySetUtc through its seam, which these tests replace before any test runs) and the source scan that replaced
       NoHqTests' check of the removed EHR.dll hooks. Package EHR-1 adds the provider row rule and the permissions (ProvKeyRuleTests,
       PermissionTests) on a scratch database of the local MariaDB (Support/ScratchDb.cs: names start with ehr1_, built from
       db/init/new-database.sql by the first test that needs it, dropped at the end, synthetic rows only), with HasProvHadKey through the
       Middle Tier mock. Package EHR-3 adds the CCD and CCR stylesheets (Cda*Tests): every page comes from a real
       OpenPmsDental.exe /ehr-render that EhrStylesheetStarter starts from the output folder (no XSLT in the test process, no window), compared
       with golden pages read from tests\EhrTests\Golden (not items: EnableDefaultNoneItems is off); its CCDs built by EhrCCD use a scratch
       database of their own whose name starts with ehr3_. No network, and the computer's clock is never set. The project references
       the program and the business library, as tests/LibWebTests does; no window of the program is ever shown. Every .cs file under this folder is compiled.
       Lans.g: the messages under test go through Lans.g, which returns the English text in the en-US culture. In any other culture it looks
       the text up in the language table, and inserts a row there for a text it has not seen, when a database connection is open. The EHR-0
       tests open none; the database tests of EHR-1 set the en-US culture first (ScratchDb.Begin), so only the scratch database could be
       touched. -->
  <ItemGroup>
    <!-- MySqlConnector (EHR-1): Support/ScratchDb.cs creates, loads and drops the ehr1_ scratch database on the local MariaDB itself, as
         tests/InventoryTests does. -->
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <!-- PresentationCore, PresentationFramework, System.Xaml and WindowsBase: the program's windows derive from types that use WPF. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- ServiceControllerStatus and ServiceStartMode: the Windows Time states of the manual time window. -->
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For FormShowFeatures.HandleEhrClick (a static method). No window of the program is ever created or shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <!-- The program's windows derive from WpfControlsOD's base types (MsgBox, the UI controls). -->
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
