<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- Tests of the EHR rebuild (docs/specs/ehr-rebuild-plan.md). Package EHR-0 adds the switch (Show Features and the Setup Wizard share one
       confirmation), the time check (the ForkTimeSyncMode setting, TimeSyncCheck, the NTP reply rules of NtpReply on synthetic RFC 5905
       packets, WindowsTime.TrySetUtc through its seam, which these tests replace before any test runs) and the source scan that replaced
       NoHqTests' check of the removed EHR.dll hooks. Package EHR-1 adds the provider row rule and the permissions (ProvKeyRuleTests,
       PermissionTests) on a scratch database of the local MariaDB (Support/ScratchDb.cs: names start with ehr1_, built from
       db/init/new-database.sql by the first test that needs it, dropped at the end, synthetic rows only), with HasProvHadKey through the
       Middle Tier mock. No network, and the computer's clock is never set. The project references
       the program and the business library, as tests/LibWebTests does; no window of the program is ever shown. Compile items are listed one
       by one until S1-6 converts this file.
       Lans.g: the messages under test go through Lans.g, which returns the English text in the en-US culture. In any other culture it looks
       the text up in the language table, and inserts a row there for a text it has not seen, when a database connection is open. The EHR-0
       tests open none; the database tests of EHR-1 set the en-US culture first (ScratchDb.Begin), so only the scratch database could be
       touched. -->

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{EA5CA88B-0C35-4647-87A2-B71E90E5A435}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>EhrTests</RootNamespace>
    <AssemblyName>EhrTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>8.0</LangVersion>
    <ProjectTypeGuids>{3AC096D0-A1C2-E12C-1390-A8335801FDAB};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <IsCodedUITest>False</IsCodedUITest>
    <TestProjectType>UnitTest</TestProjectType>
    <!-- The program and the business layer need binding redirects, as OpenPmsDental.exe gets them. Generate EhrTests.dll.config. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSTest v1, found through the search path added in Directory.Build.targets. -->
