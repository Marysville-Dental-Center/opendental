<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package V-PEARL2: the Pearl bridge's "Log Level" program property and its local troubleshooting log (Open Dental 26.1).
       No call reaches Pearl or the storage service: the HTTP layer is a fake handler and the API client is the bridge's mock. The property-row
       tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) with a unique per-run name, dropped afterwards;
       they are skipped (inconclusive) when the server does not answer, or when FORKMIGRATION_TEST_DB=skip. Synthetic data only. Every .cs file
       under this folder is compiled. -->
  <ItemGroup>
    <!-- Newtonsoft.Json, which the fake IApiRequest in PearlWiringTests implements the signatures of, comes as a package through the projects
         below. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
