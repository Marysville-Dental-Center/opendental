<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-APPT (docs/specs/port-backlog.md): Copy View, provider time on the operatory background, the Waiting Room
       window, the secondary time bar color, the Appointment Create and Move permission scope, and completed appointment tasks. Database tests
       use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password), filled with synthetic rows only, and are skipped
       (inconclusive) when it does not answer, or when BAPPT_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For WaitingRoomWindowBounds (the Waiting Room window's remembered position). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
