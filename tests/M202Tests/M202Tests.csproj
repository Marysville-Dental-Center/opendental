<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the registries at the Open Dental 26.1 level (package M2-02 in docs/specs/port-backlog.md): enum numbers from the published 25.4
       and 26.1 database documents, the 272 renumbering, permissions and the security tree, the 25.4 and 26.1 preferences, the Display Fields
       lists, the Employee Titles definition setup, and the Seed26_1 rows. Database tests use scratch MariaDB databases with unique names and
       synthetic rows only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Enum names and numbers from Open Dental's published 25.4 and 26.1 database documents (names and numbers only). -->
    <Content Include="Data\OdEnums26_1Changes.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
