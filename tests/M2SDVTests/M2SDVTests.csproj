<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-SDV (docs/specs/port-backlog.md): Service Date View, Open Dental 25.4 (window, display fields, per-user
       detailed view) and 26.1 (Account module view, statements in service-date view, statement.IsServiceDateView). The pure tests need no
       database. Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) with a name unique to the run,
       built from the 24.3.63 seed and the fork migrations, filled with synthetic rows only and dropped afterwards; they are skipped
       (inconclusive) when the server does not answer, or when M2SDV_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the grid cells of the Service Date View window and the Account module (ServiceDateViewGrid). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
