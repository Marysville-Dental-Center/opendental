<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-TP: adding procedures to the Active treatment plan from the Treatment Plan module (Open Dental 25.3). The
       placement tests (teeth, surfaces and areas per treatment area) need no database. Database tests build a scratch database on the local
       MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork migration runner, and use
       synthetic data only (made-up Z codes). They are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Wiring tests read the module and window sources, since the GUI is never launched. Every .cs file under this
       folder is compiled. -->
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
