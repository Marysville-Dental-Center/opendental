<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package P262-GLIDEWELL: Glidewell lab cases (Open Dental 26.2). The JSON and rule tests need no database. Database tests use
       scratch databases on the local MariaDB (127.0.0.1:3306, root, blank password) whose names start with test_p262glidewell_ and are unique to
       the run, dropped afterwards; they are skipped (inconclusive) when the server does not answer or when P262_TEST_DB=skip. Glidewell is never
       called: the tests use a fake client. Synthetic data only. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
