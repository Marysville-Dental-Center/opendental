<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rights of the program's database account (docs/db-connection-security.md section 5, docs/specs/db-connection-security.md sections 8
       and 9), checked on the local MariaDB at 127.0.0.1:3306 only. Manual: the harness runs only when it is told the temporary account's and
       the office database's names (DBGRANTS_ACCOUNT, DBGRANTS_DATABASE; see GrantHarnessTests.cs); otherwise it is inconclusive and nothing
       connects anywhere. It creates that account with exactly the guide's grants and a random password, builds the office database, runs the
       program's own code as the account, proves the refusals, and drops the account and every database it made. Synthetic data only.
       Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- The start-up checks of PrefL that run without a window in silent mode (the fork version guard, the MariaDB version check, the
         release channel's decision). No window of the program is created. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
