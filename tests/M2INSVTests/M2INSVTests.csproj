<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package M2-INSV (docs/specs/port-backlog.md): the Insurance Verification List's appointment day range, its pick of one or
       more carriers, and the assignment time kept as a datetime (Open Dental 25.4). Synthetic data only.
       Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) with a unique per-run name, dropped
       afterwards, and are skipped (inconclusive) when it does not answer, or when FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is
       compiled. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch-database helper shared with the fork migration tests. -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For two static helpers of the windows (FormCarriers.MergePickedCarrierNums, FormInsVerificationList.GetDateLastAssignedText). No window
         is ever created or shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
