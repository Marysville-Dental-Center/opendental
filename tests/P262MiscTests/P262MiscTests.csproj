<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package P262-MISC (Open Dental 26.2 items 37, 39 and 41): vital signs imported from eForms, the Commlog Referral Types definition
       category and the automatic switch between the Prophy and Perio recall. Database tests use one scratch database on the local MariaDB
       (127.0.0.1:3306, root, blank password) whose name starts with test_p262misc_ and is unique to the run, built from db/init/new-database.sql
       and the fork migrations and dropped afterwards; they are skipped (inconclusive) when the server does not answer or when
       P262MISC_TEST_DB=skip. The window code that needs a screen is checked from its source. Synthetic data only. Every .cs file under this
       folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
