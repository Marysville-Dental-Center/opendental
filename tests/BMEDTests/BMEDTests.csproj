<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package B-MED: medication search (24.4), the removed Missing Generic/Brand tab (25.3), the vital sign Notes box (25.3) and
       converting eForm "Other" allergies and problems to listed ones (25.2). Rule and wiring tests need no database. Database tests build one
       scratch database on the local MariaDB (127.0.0.1:3306, root, blank password) the way tools/New-DevDatabase.ps1 does, upgrade it with the fork
       migration runner, and use synthetic data only. They are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <PropertyGroup>
    <!-- As in the classic project, no DEBUG symbol in the Debug configuration (and no RELEASE in Release): only TRACE and the SDK's
         framework symbols. -->
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
