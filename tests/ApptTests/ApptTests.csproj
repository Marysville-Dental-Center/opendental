<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package A-APPT (docs/specs/port-backlog.md): appointment mirroring, appointment audit detail and the flagged-blockout
       permission. Database tests use a scratch database on the local MariaDB (127.0.0.1:3306, root, blank password), filled with synthetic rows
       only, and are skipped (inconclusive) when it does not answer, or when APPT_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For the static mirror layout of the Appointments module (ControlApptPanel.PlaceMirrors). No window is ever shown. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
  </ItemGroup>
</Project>
