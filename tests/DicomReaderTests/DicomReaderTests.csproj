<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the capture display and DICOM reader packages CAP-W1, CAP-W2 and CAP-DR (docs/imaging-capture-design.md 7.8; package
       TWAIN-W) and for the in-house full reader that replaced fo-dicom (docs/imaging/dicom-reader.md): IDicomPixelReader, DicomSubsetReader,
       DicomImageReader and its decoders, the .dcm branches of Documents.GetThumbnail and ImageHelper.GetImageCropped, and the windowing of
       legacy stored values. Every DICOM file is made in the tests: by ImagingCapture's DicomIntraOralWriter, or byte by byte from PS3.5 and
       PS3.10 (SyntheticDicom.cs, SyntheticEncodings.cs), including malformed ones; FoDicomBaseline.cs holds what fo-dicom 4 read from them
       before it was removed. No database is used; the thumbnail tests fill the preference cache in memory and use a temporary folder. Every
       .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- The .NET Framework's JPEG encoder (WPF's JpegBitmapEncoder) makes the JPEG Baseline test streams. -->
    <Reference Include="PresentationCore" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- DicomIntraOralWriter (ImagingCapture) and the pixel flavor constants (ImagingDeviceManager): the files the program itself writes. -->
    <ProjectReference Include="..\..\ImagingCapture\xImagingCapture.csproj" />
    <ProjectReference Include="..\..\ImagingDeviceManager\xImagingDeviceManager.csproj" />
  </ItemGroup>
</Project>
