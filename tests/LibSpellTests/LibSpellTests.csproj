<Project Sdk="Microsoft.NET.Sdk">
  <!-- The spell checker on WeCantSpell.Hunspell 7.0.1 (WpfControls.SpellCheckL, used by every ODtextBox and TextRich): correct and misspelled
       words, suggestions, a long note checked without a stall, the dictionary read once per process (each such test runs in a fresh AppDomain,
       like a program that just started), the office's own words (the dictcustom table) on a scratch database of the local MariaDB
       (127.0.0.1:3306, root, blank password; the name starts with test_srcref_spell_ and the database is dropped afterwards; skipped, inconclusive,
       when the server does not answer), and NHunspell with its native files gone for good. Synthetic words only. Nothing reaches the internet.
       Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <!-- The ReadOnlySpan<char> overloads of WeCantSpell.Hunspell's WordList need System.Memory to compile; it comes as a package through the
         projects below. -->
    <!-- TextRich (WpfControlsOD) is a WPF control; the tests build it, never shown, on an STA thread. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The tests read the embedded dictionary with the library itself too (its encoding and warnings). -->
    <ProjectReference Include="..\..\third-party\build\WeCantSpell.Hunspell\WeCantSpell.Hunspell.csproj" />
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- For ODtextBox, which the tests build without showing it. -->
    <ProjectReference Include="..\..\OpenPmsDental\OpenPmsDental.csproj" />
    <ProjectReference Include="..\..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
