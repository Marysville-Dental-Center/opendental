<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for backlog package V-PEARL1: the Pearl request statuses of Open Dental 24.4 (ErrorUploading 5, ErrorProcessing 6, NoResults 7),
       which requests are sent again, and the status text of the Imaging module. The rules are tested without a database. The send and poll
       tests run the real Pearl client against a fake HTTP layer (APIRequest.Inst), so nothing is ever sent to Pearl, on a scratch database on
       the local MariaDB (127.0.0.1:3306, root, blank password) built the way tools/New-DevDatabase.ps1 does and upgraded with the fork migration
       runner. Synthetic data only. Database tests are skipped (inconclusive) when the server does not answer, or when
       FORKMIGRATION_TEST_DB=skip. Every .cs file under this folder is compiled. -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch database helpers shared with the fork migration tests (database names start with forkmig_). -->
    <Compile Include="..\ForkMigrationTests\TestDb.cs">
      <Link>TestDb.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\..\UnitTestsCore\UnitTestsCore.csproj" />
  </ItemGroup>
</Project>
