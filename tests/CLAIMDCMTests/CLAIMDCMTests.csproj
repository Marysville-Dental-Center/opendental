<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for package CLAIM-DCM: DICOM X-rays on insurance claims (docs/port-notes/CLAIM-DCM.md). Synthetic 16-bit and 12-bit X-rays written
       by ImagingCapture's DicomIntraOralWriter, and malformed .dcm files, go through the rendering and attachment-building code of every claim
       path: Edit Claim's copy (ClaimAttachDicom.BuildClaimAttachFile), DentalXChange (ClaimConnect.ImageAttachment.Create) and EDS
       (EDS.ImageAttachment.Create). The windows themselves are checked from their source. No database and no network are used: the preference
       cache is filled in memory and a temporary folder stands in for the patient's A to Z folder. Every .cs file under this folder is
       compiled. -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The reader of project files (classic and SDK-style) shared by the tests that check them (S1-T of docs/specs/net10-plan.md). -->
    <Compile Include="..\ProjectFileTests\ProjectFile.cs">
      <Link>ProjectFile.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <!-- DicomIntraOralWriter (ImagingCapture) and the pixel flavor constants (ImagingDeviceManager): the files the program itself writes. -->
    <ProjectReference Include="..\..\ImagingCapture\xImagingCapture.csproj" />
    <ProjectReference Include="..\..\ImagingDeviceManager\xImagingDeviceManager.csproj" />
  </ItemGroup>
</Project>
