<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The dashboard and its graphs (Windows Forms). The SDK's default globs compile every .cs file and embed every .resx file under this folder
    (bin\ and obj\ excepted), so a new graph or dashboard window needs no edit here; every other file is a None item. Only items with their own
    metadata are listed: the linked SharedAssemblyInfo.cs, the designer files and the generated Resources.Designer.cs, and the class-based
    resource names.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenPmsDentalGraph</RootNamespace>
    <AssemblyName>OpenPmsDentalGraph</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <WarningLevel>3</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MySqlConnector">
      <HintPath>..\Required dlls\MySqlConnector.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Required dlls\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\third-party\build\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="Base\BaseGraphOptionsCtrl.Designer.cs">
      <DependentUpon>BaseGraphOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Base\GraphIncome.Designer.cs">
      <DependentUpon>GraphIncome.cs</DependentUpon>
    </Compile>
    <Compile Update="Base\GraphQuantityOverTime.Designer.cs">
      <DependentUpon>GraphQuantityOverTime.cs</DependentUpon>
    </Compile>
    <Compile Update="Base\GroupingOptionsCtrl.Designer.cs">
      <DependentUpon>GroupingOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Base\Legend.designer.cs">
      <DependentUpon>Legend.cs</DependentUpon>
    </Compile>
    <Compile Update="Concrete\BrokenApptGraphOptionsCtrl.Designer.cs">
      <DependentUpon>BrokenApptGraphOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Concrete\GraphQuantityOverTimeFilter.Designer.cs">
      <DependentUpon>GraphQuantityOverTimeFilter.cs</DependentUpon>
    </Compile>
    <Compile Update="Concrete\HqMessagesRealTimeOptionsCtrl.Designer.cs">
      <DependentUpon>HqMessagesRealTimeOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Concrete\IncomeGraphOptionsCtrl.Designer.cs">
      <DependentUpon>IncomeGraphOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Concrete\ProductionGraphOptionsCtrl.Designer.cs">
      <DependentUpon>ProductionGraphOptionsCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\DashboardCellCtrl.Designer.cs">
      <DependentUpon>DashboardCellCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\DashboardPanelCtrl.Designer.cs">
      <DependentUpon>DashboardPanelCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\DashboardTabCtrl.Designer.cs">
      <DependentUpon>DashboardTabCtrl.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\FormDashboardEditCell.Designer.cs">
      <DependentUpon>FormDashboardEditCell.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\FormDashboardEditTab.Designer.cs">
      <DependentUpon>FormDashboardEditTab.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\FormDashboardNamePrompt.Designer.cs">
      <DependentUpon>FormDashboardNamePrompt.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\FormPrintImage.Designer.cs">
      <DependentUpon>FormPrintImage.cs</DependentUpon>
    </Compile>
    <Compile Update="Dashboard\FormPrintSettings.Designer.cs">
      <DependentUpon>FormPrintSettings.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Each control's or window's .resx belongs to the .cs file of the same name, which gives it its class-based resource name
         (OpenPmsDentalGraph.GraphIncome.resources, ...). -->
    <EmbeddedResource Update="Base\*.resx;Concrete\*.resx;Dashboard\*.resx" DependentUpon="%(Filename).cs" />
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
