<Project>
  <!--
    UnitTests: the legacy test program (Unit Tests.exe, a WinExe with its own test window, FormUnitTests), kept from the code base this
    project started from (S0-5 of docs/specs/net10-plan.md); the test runner runs it with vstest like the test libraries. The SDK's default
    globs compile every .cs file and embed every .resx file under this folder (bin\ and obj\ excepted), so only the items with their own
    metadata are listed: the designer files and the .resx files of the forms (DependentUpon), the generated resource and settings files,
    and the None and Content items of the classic project (tests\Directory.Build.props turns the None glob off, as for every test project).
  -->
  <PropertyGroup>
    <!--
      The project is outside tests\, so MSBuild would import the repository's Directory.Build.props for it, not tests\Directory.Build.props,
      which holds what every test project shares. It names that file instead, before Sdk.props, which imports it; tests\Directory.Build.props
      imports the repository's own first, so each of the two is imported once. Sdk.props and Sdk.targets are therefore imported explicitly.
    -->
    <DirectoryBuildPropsPath>$(MSBuildThisFileDirectory)..\tests\Directory.Build.props</DirectoryBuildPropsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Unit Tests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The solution also builds this project as Any CPU; it compiles for x86 all the same (PlatformTarget, the repository's
         Directory.Build.props). -->
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
