<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ODR: the helper functions that RDL report definitions load as a code module (<CodeModule>ODR.dll</CodeModule>, classes ODR.Query,
    ODR.DataConnection, ODR.GetData, ODR.Format, ODR.Aggregate): OpenPmsDental/Resources/Unsched Treat Plans.rdl, ReportAccountingBalanceSheet.txt,
    ReportAccountingGenLedger.txt, and possibly an office's own reports in the A to Z folder. Built from this source and copied next to
    OpenPmsDental.exe by OpenPmsDental.csproj's reference (package RDL-SRC, docs/port-notes/RDL-SRC.md); there is no prebuilt ODR.dll any more.
    The assembly name ODR and the ODR.* class names are named inside report definitions, so they never change.
    Loaded into OpenPmsDental.exe, which is x86, like the business layer it calls (Directory.Build.props).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OpenDentalReporting</RootNamespace>
    <AssemblyName>ODR</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The program's MySQL client (MySql.Data is not shipped). -->
    <PackageReference Include="MySqlConnector" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- The class-based resource names (ODR.ComboBoxMulti.resources, ...) come from DependentUpon: the classes are in namespace ODR, not in
         the root namespace OpenDentalReporting. -->
    <EmbeddedResource Update="ComboBoxMulti.resx">
      <DependentUpon>ComboBoxMulti.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="FormParameterInput.resx">
      <DependentUpon>FormParameterInput.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ValidDate.resx">
      <DependentUpon>ValidDate.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ValidDouble.resx">
      <DependentUpon>ValidDouble.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ValidNumber.resx">
      <DependentUpon>ValidNumber.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
