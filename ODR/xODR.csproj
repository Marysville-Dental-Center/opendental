  <!--
    ODR: the helper functions that RDL report definitions load as a code module (<CodeModule>ODR.dll</CodeModule>, classes ODR.Query,
    ODR.DataConnection, ODR.GetData, ODR.Format, ODR.Aggregate): OpenDental/Resources/Unsched Treat Plans.rdl, ReportAccountingBalanceSheet.txt,
    ReportAccountingGenLedger.txt, and possibly an office's own reports in the A to Z folder. Built from this source and copied next to
    OpenDental.exe by OpenDental.csproj's reference (package RDL-SRC, docs/port-notes/RDL-SRC.md); there is no prebuilt ODR.dll any more.
    The assembly name ODR and the ODR.* class names are named inside report definitions, so they never change.
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{84688345-BB6A-4F2F-8672-A82B52FD433B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>OpenDentalReporting</RootNamespace>
    <AssemblyName>ODR</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <TargetFrameworkProfile />
    <LangVersion>8.0</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
    <ResGenToolArchitecture>Managed32Bit</ResGenToolArchitecture>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
