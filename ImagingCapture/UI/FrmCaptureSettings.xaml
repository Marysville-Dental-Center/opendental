<local:FrmODBase x:Class="ImagingCapture.UI.FrmCaptureSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental;assembly=WpfControlsOD"
             xmlns:ui="clr-namespace:WpfControls.UI;assembly=WpfControlsOD"
             mc:Ignorable="d"
             Width="1000" Height="720"
             Text="Capture Settings" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelDevice" Width="970" Height="20" Margin="12,8,0,0" Text="Device" IsBold="True" />
		<ui:Label x:Name="labelFile" Width="970" Height="34" Margin="12,30,0,0" Text="" IsWrap="True" />
		<ui:Label x:Name="labelCheck" Width="970" Height="36" Margin="12,66,0,0" Text="" IsWrap="True" ColorText="#FFC00000" />
		<ui:Grid x:Name="gridSettings" Width="970" Height="330" Margin="12,106,0,0" Title="Capture settings of this computer" TranslationName="TableCaptureSettings" />
		<ui:Label x:Name="labelSelected" Width="600" Height="20" Margin="12,444,0,0" Text="" IsBold="True" />
		<ui:Label x:Name="labelHelp" Width="970" Height="36" Margin="12,466,0,0" Text="" IsWrap="True" />
		<ui:Label x:Name="labelValue" Width="50" Height="18" Margin="12,508,0,0" Text="Value" VAlign="Bottom" />
		<ui:TextBox x:Name="textValue" Width="420" Height="21" Margin="66,506,0,0" />
		<ui:ComboBox x:Name="comboValue" Width="200" Height="21" Margin="66,506,0,0" />
		<ui:Label x:Name="labelDefault" Width="480" Height="18" Margin="500,508,0,0" Text="" VAlign="Bottom" />
		<ui:Label x:Name="labelProblems" Width="970" Height="72" Margin="12,536,0,0" Text="" IsWrap="True" ColorText="#FFC00000" />
		<ui:Label x:Name="labelGated" Width="760" Height="36" Margin="12,612,0,0" Text="Gated settings change pixels, display or safety behaviour. They change only here, with the Setup permission, and every save writes a security-log entry with the old and new values and the new settings hash." IsWrap="True" />
		<ui:Button x:Name="butUndo" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="100" Height="24" Margin="0,0,174,12" Text="Undo changes" Click="butUndo_Click" />
		<ui:Button x:Name="butSave" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="75" Height="24" Margin="0,0,93,12" Text="Save" Click="butSave_Click" />
		<ui:Button x:Name="butClose" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="75" Height="24" Margin="0,0,12,12" Text="Close" Click="butClose_Click" />
	</Grid>
</local:FrmODBase>
