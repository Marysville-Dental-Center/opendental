<local:FrmODBase x:Class="ImagingCapture.UI.FrmStandardTemplates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental;assembly=WpfControlsOD"
             xmlns:ui="clr-namespace:WpfControls.UI;assembly=WpfControlsOD"
             mc:Ignorable="d"
             Width="820" Height="600"
             Text="Add Standard Mount Templates" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelIntro" Width="790" Height="70" Margin="12,8,0,0" Text="" IsWrap="True" />
		<ui:Label x:Name="labelCategory" Width="130" Height="18" Margin="12,86,0,0" Text="X-ray category" VAlign="Bottom" />
		<ui:ComboBox x:Name="comboCategory" Width="300" Height="21" Margin="146,84,0,0" />
		<ui:Label x:Name="labelCategoryWarning" Width="790" Height="36" Margin="12,110,0,0" Text="" IsWrap="True" ColorText="#FFC00000" />
		<ui:TextBox x:Name="textPlan" Width="790" Height="340" Margin="12,150,0,0" IsMultiline="True" ReadOnly="True" ColorBack="#FFF0F0F0" />
		<ui:Button x:Name="butAdd" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="110" Height="24" Margin="0,0,93,12" Text="Add templates" Click="butAdd_Click" />
		<ui:Button x:Name="butClose" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="75" Height="24" Margin="0,0,12,12" Text="Close" Click="butClose_Click" />
	</Grid>
</local:FrmODBase>
