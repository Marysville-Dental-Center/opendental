<local:FrmODBase x:Class="ImagingCapture.UI.FrmTestCapture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenDental;assembly=WpfControlsOD"
             xmlns:ui="clr-namespace:WpfControls.UI;assembly=WpfControlsOD"
             mc:Ignorable="d"
             Width="980" Height="720"
             Text="Test Capture" >
	<Grid Background="#FFFCFDFE" >
		<ui:Label x:Name="labelDevice" Width="950" Height="34" Margin="12,8,0,0" Text="Device" IsWrap="True" />
		<ui:Label x:Name="labelUnassigned" Width="950" Height="18" Margin="12,44,0,0" Text="" ColorText="#FFC00000" />
		<ui:Label x:Name="labelSettings" Width="300" Height="18" Margin="12,66,0,0" Text="Settings in effect" IsBold="True" />
		<ui:TextBox x:Name="textSettings" Width="450" Height="330" Margin="12,86,0,0" IsMultiline="True" ReadOnly="True" ColorBack="#FFF0F0F0" />
		<ui:Label x:Name="labelBits" Width="60" Height="18" Margin="12,428,0,0" Text="Ask for" VAlign="Bottom" />
		<ui:ComboBox x:Name="comboBits" Width="120" Height="21" Margin="74,426,0,0" />
		<ui:Button x:Name="butStart" Width="120" Height="24" Margin="204,424,0,0" Text="Take test image" Click="butStart_Click" />
		<ui:Button x:Name="butStop" Width="75" Height="24" Margin="330,424,0,0" Text="Stop" Click="butStop_Click" />
		<ui:Label x:Name="labelStatus" Width="450" Height="36" Margin="12,456,0,0" Text="" IsBold="True" IsWrap="True" />
		<ui:Label x:Name="labelMessage" Width="450" Height="54" Margin="12,494,0,0" Text="" IsWrap="True" ColorText="#FFC00000" />
		<ui:CheckBox x:Name="checkByteOrder" Width="450" Height="20" Margin="12,552,0,0" Text="Byte order checked: the known ramp or the phantom shows smooth, without noise" Click="checkByteOrder_Click" />
		<ui:CheckBox x:Name="checkPolarity" Width="450" Height="20" Margin="12,576,0,0" Text="Polarity checked: the phantom's radiopaque markers show white" Click="checkPolarity_Click" />
		<ui:Label x:Name="labelCategory" Width="140" Height="18" Margin="12,610,0,0" Text="X-ray category to check" VAlign="Bottom" />
		<ui:ComboBox x:Name="comboCategory" Width="306" Height="21" Margin="156,608,0,0" />
		<ui:Label x:Name="labelPreview" Width="240" Height="18" Margin="480,66,0,0" Text="Test image" IsBold="True" />
		<Border x:Name="borderPreview" Width="240" Height="330" Margin="480,86,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="DarkGray" BorderThickness="1" Background="Black" >
			<Image x:Name="imagePreview" Stretch="Uniform" />
		</Border>
		<ui:Label x:Name="labelHistogram" Width="230" Height="18" Margin="732,66,0,0" Text="Histogram" IsBold="True" />
		<Border x:Name="borderHistogram" Width="230" Height="130" Margin="732,86,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="DarkGray" BorderThickness="1" >
			<Image x:Name="imageHistogram" Stretch="Fill" />
		</Border>
		<ui:Label x:Name="labelHistogramNote" Width="230" Height="190" Margin="732,222,0,0" Text="" IsWrap="True" />
		<ui:TextBox x:Name="textResults" Width="482" Height="200" Margin="480,424,0,0" IsMultiline="True" ReadOnly="True" ColorBack="#FFF0F0F0" />
		<ui:Label x:Name="labelCategoryWarning" Width="950" Height="36" Margin="12,636,0,0" Text="" IsWrap="True" ColorText="#FFC00000" />
		<ui:Button x:Name="butRecord" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="170" Height="24" Margin="0,0,93,12" Text="Write verification record" Click="butRecord_Click" />
		<ui:Button x:Name="butClose" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="75" Height="24" Margin="0,0,12,12" Text="Close" Click="butClose_Click" />
	</Grid>
</local:FrmODBase>
