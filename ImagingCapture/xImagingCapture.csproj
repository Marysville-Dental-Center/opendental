<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native image capture for the Imaging module: the generic UVC camera layer (DirectShow, through COM interfaces declared
    in this project from the public Windows SDK documentation), camera triggers, and the capture windows. It uses no NuGet
    package and ships no native binary. DirectShow and its Sample Grabber (qedit.dll) are part of Windows.
    WPF class library, x86 like the host (Directory.Build.props). It references ImagingDeviceManager, OpenPmsDentalBusiness, CodeBase and
    WpfControlsOD, never the OpenPmsDental assembly.
    With UseWPF the SDK's default globs compile every .cs file and build every .xaml file under this folder as a Page (bin\ and obj\
    excepted), so packages that add files never conflict over this project file.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ImagingCapture</RootNamespace>
    <AssemblyName>ImagingCapture</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <UseWPF>true</UseWPF>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\ImagingDeviceManager\xImagingDeviceManager.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
    <ProjectReference Include="..\WpfControlsOD\WpfControlsOD.csproj" />
  </ItemGroup>
</Project>
