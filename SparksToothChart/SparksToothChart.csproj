<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tooth chart: the chart model, its DirectX, OpenGL and Simple 2D engines and the WPF engine in Wpf3D (docs/specs/wpf-tooth-chart-plan.md).
    Every .cs file under this folder is compiled and every .resx embedded, so a package that adds a file does not edit this project file. No
    XAML page is left, so the project needs no UseWPF; the WPF assemblies it draws with are plain references below.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SparksToothChart</RootNamespace>
    <AssemblyName>SparksToothChart</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="SharpDX">
      <HintPath>..\Required dlls\SharpDX.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.Direct3D9">
      <HintPath>..\Required dlls\SharpDX.Direct3D9.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>..\Required dlls\SharpDX.Mathematics.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="Tao.OpenGl, Version=2.1.0.4, Culture=neutral, PublicKeyToken=1ca010269a4501ef, processorArchitecture=MSIL">
      <HintPath>..\Required dlls\Tao.OpenGl.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Tao.Platform.Windows, Version=1.0.0.4, Culture=neutral, PublicKeyToken=701104b2da67a104, processorArchitecture=MSIL">
      <HintPath>..\Required dlls\Tao.Platform.Windows.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Update="ToothChart2D.Designer.cs">
      <DependentUpon>ToothChart2D.cs</DependentUpon>
    </Compile>
    <Compile Update="ToothChartDirectX.Designer.cs">
      <DependentUpon>ToothChartDirectX.cs</DependentUpon>
    </Compile>
    <Compile Update="ToothChartOpenGL.Designer.cs">
      <DependentUpon>ToothChartOpenGL.cs</DependentUpon>
    </Compile>
    <Compile Update="ToothChartWrapper.Designer.cs">
      <DependentUpon>ToothChartWrapper.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!--
      The class-based resource names (SparksToothChart.ToothChartWrapper.resources, ...) come from DependentUpon: a net48 project names a .resx
      without it by its folder (EmbeddedResourceUseDependentUponConvention is off for .NET Framework). The 2D chart's background is in
      SparksToothChart.ToothChart2D.resources, the tooth models (Resources\*.obj, through file references) in
      SparksToothChart.Properties.Resources.resources.
    -->
    <EmbeddedResource Update="ToothChart2D.resx">
      <DependentUpon>ToothChart2D.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ToothChartDirectX.resx">
      <DependentUpon>ToothChartDirectX.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ToothChartOpenGL.resx">
      <DependentUpon>ToothChartOpenGL.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ToothChartWrapper.resx">
      <DependentUpon>ToothChartWrapper.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- The pen, eraser and colour changer cursors, as SparksToothChart.Pen.cur and so on (ToothChartWrapper.cs). -->
    <EmbeddedResource Include="ColorChanger.cur" />
    <EmbeddedResource Include="EraseCircle.cur" />
    <EmbeddedResource Include="Pen.cur" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cursors are embedded above, and the classic project listed the old ChangeLog under no item; the SDK's None glob would list both. -->
    <None Remove="ChangeLog;*.cur" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeBase\xCodeBase.csproj" />
    <ProjectReference Include="..\DataConnectionBase\xDataConnectionBase.csproj" />
    <ProjectReference Include="..\OpenPmsDentalBusiness\OpenPmsDentalBusiness.csproj" />
  </ItemGroup>
</Project>
