<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    fyiReporting RDL Project 2.9.3 report designer (RdlDesigner.exe), against the engine and viewer built from RdlEngine\ and RdlViewer\. A
    developer tool: in the solution so every build compiles it, not shipped (decision 17 of docs/specs/net10-plan.md). Every .cs and .resx file in
    this folder is compiled.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>fyiReporting.RdlDesign</RootNamespace>
    <AssemblyName>RdlDesigner</AssemblyName>
    <StartupObject>fyiReporting.RdlDesign.RdlDesigner</StartupObject>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <BaseAddress>285212672</BaseAddress>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- No symbols and no warnings in a Release build. -->
    <DebugType>none</DebugType>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each window's or control's .resx belongs to the .cs file of the same name, which gives it its class-based resource name. -->
    <EmbeddedResource Update="*.resx" DependentUpon="%(Filename).cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdlEngine\RdlEngine.csproj" />
    <ProjectReference Include="..\RdlViewer\RdlViewer.csproj" />
  </ItemGroup>
</Project>
