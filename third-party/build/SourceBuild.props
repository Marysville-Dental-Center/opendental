<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Settings shared by the projects that build a third-party library from its upstream source: PDFsharp/MigraDoc and WeCantSpell.Hunspell,
       git submodules under third-party\ that this repository references instead of copying (docs\third-party-source-builds.md). Each project
       imports this file after Microsoft.Common.props, then its library's props file (PDFsharp.props, WeCantSpell.Hunspell.props), and
       SourceBuild.targets after Microsoft.CSharp.targets. Nothing inside a submodule is changed, and nothing is restored or downloaded: the
       upstream project files (SDK style, NuGet, GitVersion, SourceLink) are not used; these classic project files compile the same source
       for the .NET Framework 4.8, x86 like the program, with the support assemblies of "Required dlls". -->
  <PropertyGroup>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputType>Library</OutputType>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- No XML documentation: the release ships only the assemblies. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- CS0436: each assembly has its own internal GitVersionInformation, as GitVersion gives every upstream assembly one, and sees the one
         of PdfSharp.Shared through InternalsVisibleTo. CS1591: upstream documents what it documents. -->
    <NoWarn>$(NoWarn);CS0436;CS1591</NoWarn>
    <!-- third-party\ (the folder of the submodules and of this build folder), with a trailing back slash. -->
    <ThirdPartyRoot>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..))</ThirdPartyRoot>
    <SourceBuildFolder>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)))</SourceBuildFolder>
  </PropertyGroup>
  <!-- Debug and Release compile the same code: upstream's Release code paths (no DEBUG symbol, which would change PDFsharp's Producer string
       and add debug checks), so a Debug build of the program behaves like the release. Only optimisation and symbols differ. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
