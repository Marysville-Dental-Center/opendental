<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Settings shared by the projects that build a third-party library from its upstream source: PDFsharp/MigraDoc and WeCantSpell.Hunspell,
       git submodules under third-party\ that this repository references instead of copying (docs\third-party-source-builds.md). Each project
       is an SDK-style project for the .NET Framework 4.8 with explicit SDK imports: the SDK's Sdk.props, then this file, then its library's
       props file (PDFsharp.props, or the properties in WeCantSpell.Hunspell.csproj), then the SDK's Sdk.targets, and SourceBuild.targets
       last, so $(IntermediateOutputPath) is set when SourceBuild.targets uses it. Nothing inside a submodule is changed, and nothing is
       downloaded: the upstream project files (NuGet, GitVersion, SourceLink) are not used; these project files compile the same source, x86
       like the program. The only packages they reference are the support assemblies the sources use (Microsoft.Extensions.Logging.Abstractions,
       System.Memory, System.Buffers, System.Runtime.CompilerServices.Unsafe), never a PDFsharp, MigraDoc or WeCantSpell package, at the
       versions of the repository's Directory.Packages.props and from the offline folder of nuget.config, as every project's packages
       (package S2-1 of docs\specs\net10-plan.md; until then they were the same files in "Required dlls"). The logging source generator that Microsoft.Extensions.Logging.Abstractions brings stays off
       (Directory.Packages.props): PdfSharp-gdi\LoggerMessages.cs and MigraDoc.DocumentObjectModel\LoggerMessages.cs hold what it writes for
       upstream's LogMessages.cs, so these projects compile the files SourceBuildItems.txt lists and nothing the generator would add. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Visual Studio's platforms; the solution builds these projects as x86. -->
    <Platforms>AnyCPU;x86</Platforms>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- The intermediate folder of the classic project files, obj\x86\Debug\ and obj\x86\Release\, not the SDK's obj\Debug\
         (Directory.Build.props turns the platform folder off): SourceBuildItems.txt lists the generated files of this folder by their full
         path, so it stays the same file. -->
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(PlatformTarget)\$(Configuration)\</IntermediateOutputPath>
    <!-- The assembly attributes come from SourceBuild.targets only (SourceBuildInfo.g.cs), not from the SDK. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Each project names its compiler symbols itself: upstream's net462 or netstandard2.0 set, not the SDK's net48 set (NETFRAMEWORK,
         NET48, NET48_OR_GREATER, ...), and no DEBUG or RELEASE (see below). -->
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <!-- No default globs: each project names what it compiles and embeds (links into the submodule, and the few files of this folder), in
         this order, as the classic project files did. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- No XML documentation: the release ships only the assemblies. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- CS0436: each assembly has its own internal GitVersionInformation, as GitVersion gives every upstream assembly one, and sees the one
         of PdfSharp.Shared through InternalsVisibleTo. CS1591: upstream documents what it documents. -->
    <NoWarn>$(NoWarn);CS0436;CS1591</NoWarn>
    <!-- third-party\ (the folder of the submodules and of this build folder), with a trailing back slash. -->
    <ThirdPartyRoot>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..))</ThirdPartyRoot>
    <SourceBuildFolder>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)))</SourceBuildFolder>
  </PropertyGroup>
  <!-- Debug and Release compile the same code: upstream's Release code paths (no DEBUG symbol, which would change PDFsharp's Producer string
       and add debug checks), so a Debug build of the program behaves like the release. Only optimisation and symbols differ. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
