<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- MigraDoc.DocumentObjectModel 6.5.0 from empira's source in the submodule third-party\PDFsharp
       (src\foundation\src\MigraDoc\src\MigraDoc.DocumentObjectModel), as upstream's MigraDoc.DocumentObjectModel.csproj builds it for net462.
       docs\third-party-source-builds.md. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{3F1D73FB-1575-4188-8E92-214AFF173E32}</ProjectGuid>
    <RootNamespace>MigraDoc</RootNamespace>
    <AssemblyName>MigraDoc.DocumentObjectModel</AssemblyName>
  </PropertyGroup>
  <Import Project="..\SourceBuild.props" />
  <Import Project="..\PDFsharp.props" />
  <PropertyGroup>
    <SourceBuildUpstreamProject>$(PdfSharpSourceRoot)MigraDoc\src\MigraDoc.DocumentObjectModel\MigraDoc.DocumentObjectModel.csproj</SourceBuildUpstreamProject>
    <SourceBuildProduct>MigraDoc</SourceBuildProduct>
    <!-- Upstream clears the project's symbols (DefineConstants ";"), so this one has no TRACE. -->
    <DefineConstants>$(PdfSharpNet462Symbols);$(PdfSharpUpstreamConstants)</DefineConstants>
    <MigraDocDomFolder>$(PdfSharpSourceRoot)MigraDoc\src\MigraDoc.DocumentObjectModel\</MigraDocDomFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\..\Required dlls\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream: every .cs file of the project folder, and the compiler attributes it links from PdfSharp.System. -->
    <Compile Include="$(MigraDocDomFolder)**\*.cs" Exclude="$(MigraDocDomFolder)bin\**;$(MigraDocDomFolder)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="$(PdfSharpSourceRoot)shared\src\PdfSharp.System\System\CompilerServices.cs">
      <Link>CompilerServices.cs</Link>
    </Compile>
    <!-- What the logging source generator of Microsoft.Extensions.Logging.Abstractions writes for
         DocumentObjectModel.Internals\LogMessages.cs. -->
    <Compile Include="LoggerMessages.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfSharp.Shared\PdfSharp.Shared.csproj">
      <Project>{E7DBF664-0058-4F44-96A8-A58F064271DC}</Project>
      <Name>PdfSharp.Shared</Name>
    </ProjectReference>
    <ProjectReference Include="..\PdfSharp.System\PdfSharp.System.csproj">
      <Project>{780459C6-739E-4C8D-9462-58D6E23B1DAC}</Project>
      <Name>PdfSharp.System</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="..\SourceBuild.targets" />
</Project>
