<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- MigraDoc.Rendering-gdi 6.5.0 from empira's source in the submodule third-party\PDFsharp, as upstream's
       src\foundation\src\MigraDoc\src\MigraDoc.Rendering-gdi\MigraDoc.Rendering-gdi.csproj builds it for net462: the shared
       MigraDoc.Rendering folder without the files that project leaves out, and the -gdi folder's own preview control.
       docs\third-party-source-builds.md. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <RootNamespace>MigraDoc</RootNamespace>
    <AssemblyName>MigraDoc.Rendering-gdi</AssemblyName>
  </PropertyGroup>
  <Import Project="..\SourceBuild.props" />
  <Import Project="..\PDFsharp.props" />
  <PropertyGroup>
    <SourceBuildUpstreamProject>$(PdfSharpSourceRoot)MigraDoc\src\MigraDoc.Rendering-gdi\MigraDoc.Rendering-gdi.csproj</SourceBuildUpstreamProject>
    <SourceBuildProduct>MigraDoc</SourceBuildProduct>
    <DefineConstants>TRACE;GDI;$(PdfSharpNet462Symbols);$(PdfSharpUpstreamConstants)</DefineConstants>
    <MigraDocRenderingFolder>$(PdfSharpSourceRoot)MigraDoc\src\MigraDoc.Rendering\</MigraDocRenderingFolder>
    <MigraDocRenderingGdiFolder>$(PdfSharpSourceRoot)MigraDoc\src\MigraDoc.Rendering-gdi\</MigraDocRenderingGdiFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\..\Required dlls\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared MigraDoc.Rendering folder, without what MigraDoc.Rendering-gdi.csproj does not compile: the WPF preview (Rendering.Windows,
         Rendering.Forms\DocumentPreviewWpf.cs) and Rendering.Printing\MigraDocPrintDocument.cs. A file upstream adds to the folder is
         compiled unless it is excluded here; PdfLibraryTests compares this list with MigraDoc.Rendering-gdi.csproj. -->
    <Compile Include="$(MigraDocRenderingFolder)**\*.cs" Exclude="$(MigraDocRenderingFolder)bin\**;$(MigraDocRenderingFolder)obj\**;$(MigraDocRenderingFolder)Rendering.Windows\**;$(MigraDocRenderingFolder)Rendering.Forms\DocumentPreviewWpf.cs;$(MigraDocRenderingFolder)Rendering.Printing\MigraDocPrintDocument.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- The -gdi folder: the GDI+ preview control. -->
    <Compile Include="$(MigraDocRenderingGdiFolder)**\*.cs" Exclude="$(MigraDocRenderingGdiFolder)bin\**;$(MigraDocRenderingGdiFolder)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <EmbeddedResource Include="$(MigraDocRenderingGdiFolder)**\*.resx" Exclude="$(MigraDocRenderingGdiFolder)bin\**;$(MigraDocRenderingGdiFolder)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <!-- The compiler attributes for the .NET Framework that upstream links from PdfSharp.System. -->
    <Compile Include="$(PdfSharpSourceRoot)shared\src\PdfSharp.System\System\CompilerServices.cs">
      <Link>CompilerServices.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\PdfSharp.System\PdfSharp.System.csproj" />
    <ProjectReference Include="..\PdfSharp-gdi\PdfSharp-gdi.csproj" />
    <ProjectReference Include="..\PdfSharp.Charting-gdi\PdfSharp.Charting-gdi.csproj" />
    <ProjectReference Include="..\MigraDoc.DocumentObjectModel\MigraDoc.DocumentObjectModel.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\SourceBuild.targets" />
</Project>
