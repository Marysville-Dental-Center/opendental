<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- PdfSharp.Charting-gdi 6.5.0 from empira's source in the submodule third-party\PDFsharp, as upstream's
       src\foundation\src\PDFsharp\src\PdfSharp.Charting-gdi\PdfSharp.Charting-gdi.csproj builds it for net462: the source files of the
       shared PdfSharp.Charting folder. docs\third-party-source-builds.md. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <RootNamespace>PdfSharp.Charting</RootNamespace>
    <AssemblyName>PdfSharp.Charting-gdi</AssemblyName>
  </PropertyGroup>
  <Import Project="..\SourceBuild.props" />
  <Import Project="..\PDFsharp.props" />
  <PropertyGroup>
    <SourceBuildUpstreamProject>$(PdfSharpSourceRoot)PDFsharp\src\PdfSharp.Charting-gdi\PdfSharp.Charting-gdi.csproj</SourceBuildUpstreamProject>
    <DefineConstants>TRACE;$(PdfSharpNet462Symbols);$(PdfSharpUpstreamConstants)</DefineConstants>
    <PdfSharpChartingFolder>$(PdfSharpSourceRoot)PDFsharp\src\PdfSharp.Charting\</PdfSharpChartingFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream links every .cs file of the PdfSharp.Charting folder. -->
    <Compile Include="$(PdfSharpChartingFolder)**\*.cs" Exclude="$(PdfSharpChartingFolder)bin\**;$(PdfSharpChartingFolder)obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Upstream's UseWindowsForms with ImplicitUsings. -->
    <Compile Include="$(SourceBuildFolder)PDFsharp\GlobalUsings.WindowsForms.cs">
      <Link>SourceBuild\GlobalUsings.WindowsForms.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfSharp.Shared\PdfSharp.Shared.csproj" />
    <ProjectReference Include="..\PdfSharp.System\PdfSharp.System.csproj" />
    <ProjectReference Include="..\PdfSharp-gdi\PdfSharp-gdi.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="..\SourceBuild.targets" />
</Project>
