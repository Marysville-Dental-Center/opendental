<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- PdfSharp.System 6.5.0 from empira's source in the submodule third-party\PDFsharp (src\foundation\src\shared\src\PdfSharp.System), as
       upstream's PdfSharp.System.csproj builds it for netstandard2.0. docs\third-party-source-builds.md. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{780459C6-739E-4C8D-9462-58D6E23B1DAC}</ProjectGuid>
    <RootNamespace>PdfSharp</RootNamespace>
    <AssemblyName>PdfSharp.System</AssemblyName>
  </PropertyGroup>
  <Import Project="..\SourceBuild.props" />
  <Import Project="..\PDFsharp.props" />
  <PropertyGroup>
    <SourceBuildUpstreamProject>$(PdfSharpSourceRoot)shared\src\PdfSharp.System\PdfSharp.System.csproj</SourceBuildUpstreamProject>
    <DefineConstants>TRACE;$(PdfSharpNetStandard20Symbols);$(PdfSharpUpstreamConstants)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>..\..\..\Required dlls\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Memory">
      <HintPath>..\..\..\Required dlls\System.Memory.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream: every .cs file of the project folder. -->
    <Compile Include="$(PdfSharpSourceRoot)shared\src\PdfSharp.System\**\*.cs" Exclude="$(PdfSharpSourceRoot)shared\src\PdfSharp.System\bin\**;$(PdfSharpSourceRoot)shared\src\PdfSharp.System\obj\**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PdfSharp.Shared\PdfSharp.Shared.csproj">
      <Project>{E7DBF664-0058-4F44-96A8-A58F064271DC}</Project>
      <Name>PdfSharp.Shared</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="..\SourceBuild.targets" />
</Project>
