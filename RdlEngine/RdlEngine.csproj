<Project Sdk="Microsoft.NET.Sdk">
  <!--
    fyiReporting RDL Project 2.9.3 engine, LGPL 2.1 or later. OpenPmsDental.csproj builds it from this source and ships the result, in place
    of the prebuilt RdlEngine.dll it used to reference (package RDL-SRC, docs/port-notes/RDL-SRC.md).
    Changed by Open PMS - Dental contributors, 2026-11-01: targets .NET Framework 4.8 like the program (was 4.5); no MySql.Data reference,
    package or app.config (no compiled file used MySql.Data; the MySQL.NET data provider is loaded by name, see Runtime\RdlEngineConfig.cs).
    2026-11-08: SDK-style project (stage 1 of the .NET 10 move, docs/specs/net10-plan.md); every .cs file in this folder is compiled, as before.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RdlEngine</RootNamespace>
    <AssemblyName>RdlEngine</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Platforms>AnyCPU;x86</Platforms>
    <BaseAddress>285212672</BaseAddress>
    <FileAlignment>4096</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- No symbols in a Release build. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>
</Project>
