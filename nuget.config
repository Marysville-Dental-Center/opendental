<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet restores from one local folder only, never from nuget.org or another feed: a package that is not in the folder
  is a restore error, never a download (docs/specs/net10-plan.md, section 2.4 and stage 1).

  The folder is outside the repository. The environment variable OPMS_NUGET_OFFLINE names it, in the process of each
  build: tools\Initialize-BuildEnvironment.ps1 sets it, when it is not set already, to od-tools\nuget-packages in the
  repository's git folder (the common git folder, the same for every worktree), and the build lane and the tool scripts
  call it. Without the variable NuGet reads the value as it stands, a folder named %OPMS_NUGET_OFFLINE% next to this file,
  which does not exist, so a restore that needs a package fails with NU1301 and asks no other source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="opms-offline" value="%OPMS_NUGET_OFFLINE%" />
  </packageSources>
  <!-- No vulnerability data source: the offline folder has none, and no other source is asked. -->
  <auditSources>
    <clear />
  </auditSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
