<Project>
  <!--
    Shared settings, imported by every project in this repository: Microsoft.Common.props imports this file for the
    classic C# projects, the SDK-style ones and Direct2dWrapper.vcxproj alike.

    Everything in it is for SDK-style projects only. Microsoft.NET.Sdk sets UsingMicrosoftNETSdk before it imports
    this file; the classic projects, the classic Middle Tier project (OpenPmsDentalServer) and Direct2dWrapper.vcxproj
    never set it, so they build exactly as before. Stage 1 of the .NET 10 move (docs/specs/net10-plan.md, section 2.3)
    converts the C# projects to SDK-style one by one; with these settings they keep today's output folders and files.
  -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <!--
      One flat output folder per configuration, as today: bin\Debug\ and bin\Release\, without a net48\ or win-x86\
      sub folder, and without the platform folder the SDK adds for any platform other than AnyCPU (bin\x86\Debug\).
      The SDK then computes OutputPath as bin\$(Configuration)\ after the project's own properties, when
      $(Configuration) is known (Microsoft.NET.DefaultOutputPaths.targets), so the path is right even for a project
      built on its own without a configuration.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!-- AssemblyInfo.cs and SharedAssemblyInfo.cs stay the only source of the assembly attributes and versions. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <!-- Only the English resources of packages; no language folders in the output. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Every restore writes packages.lock.json; the build lane restores in locked mode, so a change is an error. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!--
      The SDK writes a supportedRuntime element into a .NET Framework exe's app.config and saves the file again (other
      XML declaration and indentation) unless this is off; with it off, every exe's .config stays byte for byte as today.
    -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <!-- No Source Link: the PDBs record no repository URL or commit, and the build does not read the .git folder. -->
    <EnableSourceLink>false</EnableSourceLink>
    <!--
      For UseWPF projects (WpfControlsOD, ImagingCapture since S1-4): the SDK builds the pages with its own WPF build targets instead of
      the .NET Framework's, and for those it embeds the generated sources (obj\**\*.g.cs) in the PDB unless this is off; off, as for the
      classic projects, so the PDB holds no source text. Its markup compiler also writes a SHA-1 checksum of each .xaml file into the
      generated .g.cs (#pragma checksum, kept in the PDB) unless told otherwise; the .NET Framework's wrote SHA-256, the compiler's own
      default for the .cs files, so SHA-256 it stays. Both are the compiler's defaults for projects without pages.
    -->
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <ChecksumAlgorithm>SHA256</ChecksumAlgorithm>
    <!--
      AutoGenerateBindingRedirects is not set here. A project that leaves it empty gets it on: the SDK turns it on for
      every .NET Framework exe and test project (Microsoft.NET.Sdk.BeforeCommon.targets), and MSBuild's common targets
      for every project that targets .NET Framework 4.7.2 or later (Microsoft.Common.CurrentVersion.targets), so the
      classic projects (UnitTests and the test projects, until S1-6) have it on as well, as the program, ServiceManager,
      the HL7 service and UnitTestsCore had before S1-4 and S1-5 converted them. An
      SDK-style project thus gets the same default as a classic one, and when stage 2's packages bring version conflicts,
      the build generates their redirects as the classic build would. Turning it off for the SDK-style projects, as
      this file did until 2026-11-08, changed no .config of any output folder (docs/specs/net10-plan.md, S1-5). A
      project that sets it in its own file keeps its own value.
    -->
  </PropertyGroup>
</Project>
